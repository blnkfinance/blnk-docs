---
import { getCollection, render } from 'astro:content';
import { assertPagesExist, navigation, pageHref } from '../content/nav';
import { documentTitle, metaDescription, pageMarkdown } from '../content/seo';
import * as mdxComponents from '../ui/mdx/components';
import DocsLayout from '../ui/DocsLayout.astro';

export async function getStaticPaths() {
	const docs = await getCollection('docs');
	assertPagesExist(
		navigation,
		new Set(docs.map((entry) => entry.id)),
	);

	return docs.map((entry) => ({
		params: { slug: pageHref(entry.id) === '/' ? undefined : pageHref(entry.id).slice(1) },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const description = metaDescription(entry.data.metaDescription, entry.data.description);
const markdown = pageMarkdown(entry.data.title, description, entry.body);
---

<DocsLayout
	title={entry.data.title}
	documentTitle={documentTitle(entry.data.seoTitle, entry.data.title)}
	description={description}
	indexable={!entry.data.noindex}
	headings={headings}
	markdown={markdown}
>
	<Content components={mdxComponents} />
</DocsLayout>
