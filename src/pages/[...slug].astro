---
import { getCollection, render } from 'astro:content';
import { documentTitle, homeDocumentTitle, metaDescription, pageMarkdown } from '../lib/seo';
import { assertPagesExist, assertRedirects, enterpriseNotice, navigation, pageHref, redirects } from '../ui/navigation';
import * as mdxComponents from '../ui/mdx/components';
import { withSnippets } from '../ui/mdx/snippets';
import DocsLayout from '../ui/DocsLayout.astro';
import Tutorial from '../ui/Tutorial.astro';

export async function getStaticPaths() {
	const docs = await getCollection('docs');
	const ids = new Set(docs.map((entry) => entry.id));
	assertPagesExist(navigation, ids);
	assertRedirects(redirects, ids);

	return docs.map((entry) => ({
		params: { slug: pageHref(entry.id) === '/' ? undefined : pageHref(entry.id).slice(1) },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const components = withSnippets(mdxComponents);
const description = metaDescription(entry.data.metaDescription, entry.data.description);
const notice = enterpriseNotice(entry.data.enterprise);
const markdown = pageMarkdown(entry.data.title, description, entry.body ?? '', notice);
const tutorialId = entry.id.replace(/^tutorials\//, '');
---

<DocsLayout
	title={entry.data.title}
	documentTitle={pageHref(entry.id) === '/' ? homeDocumentTitle : documentTitle(entry.data.title)}
	description={description}
	indexable={!entry.data.noindex}
	headings={headings}
	markdown={markdown}
	lede={entry.data.description}
	method={entry.data.method}
	endpoint={entry.data.path}
	enterprise={notice}
	toc={!entry.data.tutorial}
	tutorial={entry.data.tutorial}
>
	{
		entry.data.tutorial ? (
			<Tutorial id={tutorialId}>
				<Content components={components} />
			</Tutorial>
		) : (
			<Content components={components} />
		)
	}
</DocsLayout>
