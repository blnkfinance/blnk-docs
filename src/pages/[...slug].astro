---
import { getCollection, render } from 'astro:content';
import { documentTitle, metaDescription, pageMarkdown } from '../lib/seo';
import { assertPagesExist, labels, navigation, pageHref } from '../ui/navigation';
import * as mdxComponents from '../ui/mdx/components';
import { withSnippets } from '../ui/mdx/snippets';
import DocsLayout from '../ui/DocsLayout.astro';

export async function getStaticPaths() {
	const docs = await getCollection('docs');
	assertPagesExist(
		navigation,
		new Set(docs.map((entry) => entry.id)),
	);

	return docs.map((entry) => ({
		params: { slug: pageHref(entry.id) === '/' ? undefined : pageHref(entry.id).slice(1) },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const components = withSnippets(mdxComponents);
const description = metaDescription(entry.data.metaDescription, entry.data.description);
const markdown = pageMarkdown(
	entry.data.title,
	description,
	entry.body,
	entry.data.enterprise ? labels.enterprise : undefined,
);
---

<DocsLayout
	title={entry.data.title}
	documentTitle={documentTitle(entry.data.seoTitle, entry.data.title)}
	description={description}
	indexable={!entry.data.noindex}
	headings={headings}
	markdown={markdown}
	lede={entry.data.description}
	method={entry.data.method}
	endpoint={entry.data.path}
	enterprise={entry.data.enterprise}
>
	<Content components={components} />
</DocsLayout>
