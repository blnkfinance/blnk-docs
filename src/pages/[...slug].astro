---
import { getCollection, render } from 'astro:content';
import { assertPagesExist, navigation, pageHref } from '../content/nav';
import * as mdxComponents from '../ui/mdx/components';
import DocsLayout from '../ui/DocsLayout.astro';

export async function getStaticPaths() {
	const docs = await getCollection('docs');
	assertPagesExist(
		navigation,
		new Set(docs.map((entry) => entry.id)),
	);

	return docs.map((entry) => ({
		params: { slug: pageHref(entry.id) === '/' ? undefined : pageHref(entry.id).slice(1) },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const markdown = [`# ${entry.data.title}`, entry.body?.trim() ?? ''].filter(Boolean).join('\n\n');
---

<DocsLayout title={entry.data.title} description={entry.data.description} headings={headings} markdown={markdown}>
	<Content components={mdxComponents} />
</DocsLayout>
