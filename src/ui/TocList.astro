---
import type { TocItem } from '../lib/toc';

interface Props {
	item: TocItem;
}

const { item } = Astro.props;
---

<li>
	<a href={`#${item.slug}`} data-toc-tab={item.tab ? true : undefined}>{item.text}</a>
	{
		item.children.length > 0 && (
			<ul>
				{item.children.map((child) => (
					<Astro.self item={child} />
				))}
			</ul>
		)
	}
</li>
