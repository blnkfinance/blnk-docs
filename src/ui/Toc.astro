---
import type { MarkdownHeading } from 'astro';
import { renderIcon } from '../icons/mingcute';
import { tocItems } from '../lib/toc';
import TocList from './TocList.astro';

const copyIcon = await renderIcon('copy-2', 16);

interface StepLink {
	id: string;
	title: string;
}

interface Props {
	headings: MarkdownHeading[];
	markdown: string;
	sections?: boolean;
	steps?: StepLink[];
}

const { headings, markdown, sections = true, steps = [] } = Astro.props;
const groups = tocItems(headings, markdown);
const changelog = markdown.includes('<Update ');
const tutorialSteps = steps.length > 0;
const hasSections =
	tutorialSteps || (sections && groups.length > 0 && (changelog || headings.some((heading) => heading.depth === 2)));

const pageJson = JSON.stringify(markdown).replace(/</g, '\\u003c');
---

<aside class="toc">
	<div class="toc-body">
		{
			hasSections && (
				<nav aria-label="On this page">
					<ul>
						{tutorialSteps
							? steps.map((step) => (
									<li>
										<a href={`#${step.id}`} data-tutorial-step={step.id}>
											{step.title}
										</a>
									</li>
								))
							: groups.map((group) => <TocList item={group} />)}
					</ul>
				</nav>
			)
		}
		<div class:list={['copy', { divided: hasSections }]}>
			<button type="button" data-copy-page>
				<Fragment set:html={copyIcon} />
				<span data-copy-label>Copy page</span>
			</button>
		</div>
	</div>
	<script is:inline type="application/json" data-page-markdown set:html={pageJson}></script>
</aside>

<script>
	const root = document.documentElement;

	function assignTabIds() {
		const links = [...document.querySelectorAll('.toc a[data-toc-tab]')];
		const panels = [...document.querySelectorAll('.article .tab')];
		panels.forEach((panel, index) => {
			const link = links[index];
			if (!(panel instanceof HTMLElement) || !(link instanceof HTMLAnchorElement)) return;
			panel.id = decodeURIComponent(link.hash.slice(1));
		});
	}

	function selectTab(tabs: HTMLElement, index: number) {
		const panels = [...tabs.querySelectorAll(':scope > .tab')];
		if (index < 0 || index >= panels.length) return;
		panels.forEach((item, itemIndex) => {
			if (item instanceof HTMLElement) item.hidden = itemIndex !== index;
		});
		tabs.querySelectorAll(':scope > .tab-bar .tab-button').forEach((button, itemIndex) => {
			button.setAttribute('aria-selected', itemIndex === index ? 'true' : 'false');
		});
	}

	function showTab(panel: HTMLElement) {
		const tabs = panel.closest('[data-tabs]');
		if (!(tabs instanceof HTMLElement)) return;
		const panels = [...tabs.querySelectorAll(':scope > .tab')];
		const index = panels.indexOf(panel);
		const id = tabs.dataset.sync;
		if (!id) {
			selectTab(tabs, index);
			return;
		}
		document.querySelectorAll(`[data-tabs][data-sync="${CSS.escape(id)}"]`).forEach((other) => {
			if (other instanceof HTMLElement) selectTab(other, index);
		});
	}

	function tocEntries() {
		return [...document.querySelectorAll('.toc nav a')].flatMap((link) => {
			if (!(link instanceof HTMLAnchorElement) || link.hasAttribute('data-tutorial-step')) return [];
			const id = decodeURIComponent(link.hash.slice(1));
			const heading = document.getElementById(id);
			return heading ? [{ link, heading }] : [];
		});
	}

	function markCurrentHeading() {
		const line = 72;
		const tocLinks = tocEntries();
		let current = null;
		for (const item of tocLinks) {
			if (item.heading.getClientRects().length === 0) continue;
			if (item.heading.getBoundingClientRect().top <= line) current = item;
		}
		for (const item of tocLinks) {
			if (item === current) item.link.setAttribute('aria-current', 'location');
			else item.link.removeAttribute('aria-current');
		}
	}

	function revealTarget(id: string, smooth: boolean) {
		const heading = document.getElementById(id);
		if (!heading) return;
		if (heading.classList.contains('tab')) showTab(heading);
		const target = heading.classList.contains('tab') ? (heading.closest('.tabs') ?? heading) : heading;
		const previous = root.style.scrollBehavior;
		if (!smooth) root.style.scrollBehavior = 'auto';
		target.scrollIntoView({ block: 'start' });
		root.style.scrollBehavior = previous;
		markCurrentHeading();
	}

	function revealHash() {
		const id = decodeURIComponent(location.hash.slice(1));
		if (!id) return;
		revealTarget(id, false);
	}

	document.addEventListener(
		'click',
		(event) => {
			if (!(event.target instanceof Element)) return;
			const link = event.target.closest('.toc a[data-toc-tab]');
			if (!(link instanceof HTMLAnchorElement)) return;
			const id = decodeURIComponent(link.hash.slice(1));
			if (!document.getElementById(id)) return;
			event.preventDefault();
			event.stopPropagation();
			history.pushState(history.state, '', `#${id}`);
			revealTarget(id, true);
		},
		true,
	);

	document.addEventListener('click', (event) => {
		if (!(event.target instanceof Element)) return;
		const copyButton = event.target.closest('[data-copy-page]');
		if (!(copyButton instanceof HTMLButtonElement)) return;
		const copySource = document.querySelector('[data-page-markdown]');
		if (!copySource?.textContent) return;
		const label = copyButton.querySelector('[data-copy-label]');
		void navigator.clipboard.writeText(JSON.parse(copySource.textContent)).then(() => {
			if (label) label.textContent = 'Copied';
			window.setTimeout(() => {
				if (label) label.textContent = 'Copy page';
			}, 2000);
		});
	});

	document.addEventListener('click', (event) => {
		if (!(event.target instanceof Element)) return;
		const button = event.target.closest('.tab-button');
		if (!(button instanceof HTMLElement)) return;
		const tabs = button.closest('[data-tabs]');
		if (!(tabs instanceof HTMLElement)) return;
		const buttons = [...tabs.querySelectorAll(':scope > .tab-bar .tab-button')];
		const panels = [...tabs.querySelectorAll(':scope > .tab')];
		const panel = panels[buttons.indexOf(button)];
		if (!(panel instanceof HTMLElement) || !panel.id) return;
		history.replaceState(history.state, '', `#${panel.id}`);
		window.setTimeout(markCurrentHeading, 0);
	});

	document.addEventListener('scroll', markCurrentHeading, { passive: true });
	window.addEventListener('hashchange', revealHash);

	function bootToc() {
		assignTabIds();
		markCurrentHeading();
		revealHash();
	}

	bootToc();
	document.addEventListener('astro:page-load', bootToc);
</script>

<style>
	.toc {
		position: sticky;
		top: 48px;
		box-sizing: border-box;
		display: flex;
		flex-direction: column;
		justify-self: end;
		width: 16rem;
		max-width: 100%;
		min-width: 0;
		height: calc(100dvh - 48px);
		padding: 2.5rem 1.25rem 0;
		font-size: 14px;
	}

	.toc-body {
		flex: 1;
		min-height: 0;
		overflow: auto;
	}

	.copy.divided {
		margin-top: 1.25rem;
		padding-top: 1rem;
		border-top: 1px solid var(--divider);
	}

	.copy button :global(svg) {
		display: block;
		flex: none;
		overflow: visible;
	}

	.copy button {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		box-sizing: border-box;
		width: 100%;
		padding: 0.4rem 0.5rem;
		border: 0;
		border-radius: 0.375rem;
		background: transparent;
		color: var(--muted);
		font: inherit;
		font-size: 14px;
		line-height: 1.4;
		text-align: left;
		cursor: pointer;
	}

	.copy button:hover {
		color: var(--fg);
		background: var(--fill);
	}

	.copy button:focus-visible {
		outline: 2px solid var(--fg);
		outline-offset: 2px;
	}

	@media (max-width: 1279px) {
		.copy button {
			min-height: 44px;
		}
	}

	.toc :global(ul) {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.toc :global(li + li) {
		margin-top: calc(0.4rem + 2px);
	}

	.toc :global(ul ul) {
		margin-top: calc(0.4rem + 2px);
		padding-left: 0.75rem;
		border-left: 1px solid var(--line);
	}

	.toc :global(a) {
		color: var(--muted);
		text-decoration: none;
	}

	.toc :global(a:hover) {
		color: var(--fg);
	}

	.toc :global(a[aria-current='location']),
	.toc :global(a[aria-current='location']:hover) {
		color: var(--primary);
	}

	.toc :global(a[data-done]::after) {
		content: 'Done';
		margin-left: 0.45rem;
		font-size: 11px;
		letter-spacing: 0.02em;
	}
</style>
