---
import type { MarkdownHeading } from 'astro';

interface Props {
	headings: MarkdownHeading[];
}

const items = Astro.props.headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---

<aside class="toc">
	<p>On this page</p>
	<nav aria-label="On this page">
		<ul>
			{
				items.map((heading) => (
					<li data-depth={heading.depth}>
						<a href={`#${heading.slug}`}>{heading.text}</a>
					</li>
				))
			}
		</ul>
	</nav>
</aside>

<style>
	.toc {
		position: sticky;
		top: 48px;
		max-height: calc(100vh - 48px);
		overflow: auto;
		padding: 1.5rem 1.25rem;
	}

	p {
		margin: 0 0 0.75rem;
		font-weight: 500;
	}

	ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	li + li {
		margin-top: 0.4rem;
	}

	li[data-depth='3'] {
		padding-left: 0.75rem;
	}

	a {
		color: var(--muted);
		text-decoration: none;
	}

	a:hover {
		color: var(--fg);
	}
</style>
