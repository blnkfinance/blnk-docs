---
import type { MarkdownHeading } from 'astro';

interface Props {
	headings: MarkdownHeading[];
	markdown: string;
}

const { headings, markdown } = Astro.props;
const hasSections = headings.some((heading) => heading.depth === 2);
const items = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const pageJson = JSON.stringify(markdown).replace(/</g, '\\u003c');
---

<aside class="toc">
	<div class="toc-body">
		{
			hasSections && (
				<nav aria-label="On this page">
					<ul>
						{items.map((heading) => (
							<li data-depth={heading.depth}>
								<a href={`#${heading.slug}`}>{heading.text}</a>
							</li>
						))}
					</ul>
				</nav>
			)
		}
		<div class:list={['copy', { divided: hasSections }]}>
			<button type="button" data-copy-page>
				<svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true">
					<rect x="5.5" y="5.5" width="8" height="8" rx="1.25" fill="none" stroke="currentColor" stroke-width="1.5"></rect>
					<path d="M4.5 10.5H3.75A1.25 1.25 0 0 1 2.5 9.25v-5.5A1.25 1.25 0 0 1 3.75 2.5h5.5A1.25 1.25 0 0 1 10.5 3.75V4.5" fill="none" stroke="currentColor" stroke-width="1.5"></path>
				</svg>
				<span data-copy-label>Copy page</span>
			</button>
		</div>
	</div>
	<script is:inline type="application/json" data-page-markdown set:html={pageJson}></script>
</aside>

<script>
	const root = document.documentElement;
	const copyButton = document.querySelector('[data-copy-page]');
	const copySource = document.querySelector('[data-page-markdown]');

	const tocLinks = [...document.querySelectorAll('.toc nav a')].flatMap((link) => {
		if (!(link instanceof HTMLAnchorElement)) return [];
		const id = decodeURIComponent(link.hash.slice(1));
		const heading = document.getElementById(id);
		return heading ? [{ link, heading }] : [];
	});

	function markCurrentHeading() {
		const line = 72;
		let current = null;
		for (const item of tocLinks) {
			if (item.heading.getBoundingClientRect().top <= line) current = item;
		}
		for (const item of tocLinks) {
			if (item === current) item.link.setAttribute('aria-current', 'location');
			else item.link.removeAttribute('aria-current');
		}
	}

	function revealHash() {
		const id = decodeURIComponent(location.hash.slice(1));
		if (!id) return;
		const heading = document.getElementById(id);
		if (!heading) return;
		const previous = root.style.scrollBehavior;
		root.style.scrollBehavior = 'auto';
		heading.scrollIntoView({ block: 'start' });
		root.style.scrollBehavior = previous;
		markCurrentHeading();
	}

	if (tocLinks.length) {
		document.addEventListener('scroll', markCurrentHeading, { passive: true });
	}

	revealHash();
	window.addEventListener('load', revealHash);

	copyButton?.addEventListener('click', async () => {
		if (!copySource?.textContent) return;
		const label = copyButton.querySelector('[data-copy-label]');
		await navigator.clipboard.writeText(JSON.parse(copySource.textContent));
		if (label) label.textContent = 'Copied';
		window.setTimeout(() => {
			if (label) label.textContent = 'Copy page';
		}, 2000);
	});
</script>

<style>
	.toc {
		position: sticky;
		top: 48px;
		box-sizing: border-box;
		display: flex;
		flex-direction: column;
		height: calc(100vh - 48px);
		padding: 1.5rem 1.25rem 0;
	}

	.toc-body {
		flex: 1;
		min-height: 0;
		overflow: auto;
	}

	.copy.divided {
		margin-top: 1.25rem;
		padding-top: 1rem;
		border-top: 1px solid var(--divider);
	}

	.copy button {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		width: 100%;
		padding: 0.35rem 0.15rem;
		border: 0;
		border-radius: 0.375rem;
		background: transparent;
		color: var(--muted);
		font: inherit;
		text-align: left;
		cursor: pointer;
	}

	.copy button:hover {
		color: var(--fg);
		background: var(--fill);
	}

	.copy button:focus-visible {
		outline: 2px solid var(--fg);
		outline-offset: 2px;
	}

	ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	li + li {
		margin-top: 0.4rem;
	}

	li[data-depth='3'] {
		padding-left: 0.75rem;
	}

	a {
		color: var(--muted);
		text-decoration: none;
	}

	a:hover {
		color: var(--fg);
	}

	a[aria-current='location'],
	a[aria-current='location']:hover {
		color: var(--primary);
	}
</style>
