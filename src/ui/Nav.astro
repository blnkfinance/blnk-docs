---
import { getCollection } from 'astro:content';
import { activeTab, navigation } from '../content/nav';
import Pages from './Pages.astro';

const groups = activeTab(navigation, Astro.url.pathname).groups;
const docs = await getCollection('docs');
const titles = new Map(docs.map((entry) => [entry.id, entry.data.title]));
---

<nav class="sidebar">
	{
		groups.map((group) => (
			<div>
				<p>{group.group}</p>
				<Pages pages={group.pages} titles={titles} />
			</div>
		))
	}
</nav>
