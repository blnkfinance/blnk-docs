---
import { getCollection } from 'astro:content';
import { renderIcon } from '../icons/mingcute';
import { sidebarLabel } from '../lib/seo';
import { activeMenu, activeTab, navigation, sidebarGroups } from './navigation';
import Pages from './Pages.astro';

const sun = await renderIcon('sun', 16);
const moon = await renderIcon('moon', 16);
const system = await renderIcon('computer', 16);
const check = await renderIcon('check', 14);

const pathname = Astro.url.pathname;
const tab = activeTab(navigation, pathname);
const menu = 'menu' in tab ? activeMenu(tab, pathname) : undefined;
const navScope = menu?.path ?? ('tab' in tab ? tab.tab : 'home');
const sidebarKey = `sidebar-${navScope.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '') || 'home'}`;
const groups = sidebarGroups(navigation, pathname);
const docs = await getCollection('docs');
const titles = new Map(
	docs.map((entry) => [entry.id, sidebarLabel(entry.data.sidebarTitle, entry.data.title)]),
);
const pageIcons = new Map(
	docs.flatMap((entry) => (entry.data.icon ? [[entry.id, entry.data.icon] as const] : [])),
);
const methods = new Map(
	docs.flatMap((entry) => (entry.data.method ? [[entry.id, entry.data.method] as const] : [])),
);
---

<nav
	class="sidebar"
	id="docs-nav"
	aria-label="Documentation"
	data-nav-scope={navScope}
	transition:persist={sidebarKey}
	transition:animate="none"
>
	<div class="sidebar-body">
		{
			groups.map((group, index) => (
				<div class="nav-group">
					<p class="nav-label">{group.group}</p>
					<Pages pages={group.pages} titles={titles} pageIcons={pageIcons} methods={methods} pathname={pathname} idPrefix={`nav-${index}`} />
				</div>
			))
		}
	</div>
	<a
		class="drawer-dashboard"
		href="https://cloud.blnkfinance.com/auth/sign-in?utm_source=blnk_docs&utm_medium=documentation&utm_campaign=navbar"
		>Open Dashboard</a
	>
	<div class="theme" data-theme-root>
		<button
			class="theme-button"
			type="button"
			aria-haspopup="menu"
			aria-expanded="false"
			aria-label="Theme"
			data-theme-button
		>
			<span class="theme-icon" data-icon="light"><Fragment set:html={sun} /></span>
			<span class="theme-icon" data-icon="dark"><Fragment set:html={moon} /></span>
			<span class="theme-icon" data-icon="system"><Fragment set:html={system} /></span>
		</button>
		<div class="theme-menu" role="menu" hidden data-theme-menu>
			<button type="button" role="menuitemradio" data-theme-value="light" aria-checked="false">
				Light
				<span class="check"><Fragment set:html={check} /></span>
			</button>
			<button type="button" role="menuitemradio" data-theme-value="dark" aria-checked="false">
				Dark
				<span class="check"><Fragment set:html={check} /></span>
			</button>
			<button type="button" role="menuitemradio" data-theme-value="system" aria-checked="false">
				System
				<span class="check"><Fragment set:html={check} /></span>
			</button>
		</div>
	</div>
	<script is:inline>
		(() => {
			const sidebar = document.currentScript?.closest('.sidebar');
			if (!(sidebar instanceof HTMLElement)) return;
			const key = `nav-open:${sidebar.dataset.navScope ?? ''}`;
			let stored = [];
			try {
				const raw = sessionStorage.getItem(key);
				const parsed = raw ? JSON.parse(raw) : [];
				if (Array.isArray(parsed)) stored = parsed.filter((id) => typeof id === 'string');
			} catch {
				stored = [];
			}
			const open = new Set(stored);
			sidebar.querySelectorAll('[data-nav-toggle]').forEach((button) => {
				if (!(button instanceof HTMLButtonElement)) return;
				const id = button.getAttribute('aria-controls');
				const panel = id ? document.getElementById(id) : null;
				if (!id || !(panel instanceof HTMLElement)) return;
				if (button.getAttribute('aria-expanded') === 'true') open.add(id);
				else if (open.has(id)) {
					button.setAttribute('aria-expanded', 'true');
					panel.hidden = false;
				}
			});
			try {
				sessionStorage.setItem(key, JSON.stringify([...open]));
			} catch {
				/* storage can be unavailable */
			}

			const body = sidebar.querySelector('.sidebar-body');
			const current = sidebar.querySelector('a.nav-item[aria-current="page"]');
			if (!(body instanceof HTMLElement) || !(current instanceof HTMLElement)) return;
			const showCurrent = () => {
				if (body.clientHeight === 0) return;
				const item = current.getBoundingClientRect();
				const top = item.top - body.getBoundingClientRect().top;
				const bottom = top + item.height;
				if (top >= 0 && bottom <= body.clientHeight) return;
				body.scrollTop = Math.max(0, body.scrollTop + top - (body.clientHeight - item.height) / 2);
			};
			showCurrent();
			requestAnimationFrame(showCurrent);
			window.addEventListener(
				'load',
				() => {
					showCurrent();
					requestAnimationFrame(showCurrent);
				},
				{ once: true },
			);
		})();
	</script>
</nav>

<script>
	const root = document.documentElement;
	const boundSidebars = new WeakSet<HTMLElement>();
	const navEase = 'cubic-bezier(0.23, 1, 0.32, 1)';
	const navAnimations = new WeakMap<HTMLElement, Animation>();

	function appearance(theme: string) {
		if (theme === 'dark') return 'dark';
		if (theme === 'light') return 'light';
		return matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
	}

	function syncThemeUi() {
		const theme = root.dataset.theme ?? 'system';
		document.querySelectorAll('[data-theme-button]').forEach((themeButton) => {
			if (themeButton instanceof HTMLElement) themeButton.setAttribute('aria-label', `Theme, ${theme}`);
		});
		document.querySelectorAll('[data-theme-menu] [data-theme-value]').forEach((item) => {
			if (!(item instanceof HTMLElement)) return;
			item.setAttribute('aria-checked', String(item.dataset.themeValue === theme));
		});
	}

	function applyTheme(theme: string) {
		root.dataset.theme = theme;
		root.dataset.appearance = appearance(theme);
		localStorage.setItem('theme', theme);
		syncThemeUi();
	}

	function closeThemeMenu() {
		document.querySelectorAll('[data-theme-menu]').forEach((themeMenu) => {
			if (!(themeMenu instanceof HTMLElement) || themeMenu.hidden) return;
			themeMenu.hidden = true;
			themeMenu
				.closest('[data-theme-root]')
				?.querySelector('[data-theme-button]')
				?.setAttribute('aria-expanded', 'false');
		});
	}

	function saveOpen(sidebar: HTMLElement) {
		const key = `nav-open:${sidebar.dataset.navScope ?? ''}`;
		const open: string[] = [];
		sidebar.querySelectorAll('[data-nav-toggle][aria-expanded="true"]').forEach((item) => {
			const id = item.getAttribute('aria-controls');
			if (id) open.push(id);
		});
		try {
			sessionStorage.setItem(key, JSON.stringify(open));
		} catch {
			/* storage can be unavailable */
		}
	}

	function normalizePath(pathname: string) {
		return pathname.length > 1 && pathname.endsWith('/') ? pathname.slice(0, -1) : pathname;
	}

	function markSidebar(sidebar: HTMLElement) {
		const path = normalizePath(location.pathname);
		sidebar.querySelectorAll('a.nav-item').forEach((link) => {
			if (!(link instanceof HTMLAnchorElement)) return;
			if (normalizePath(link.pathname) === path) link.setAttribute('aria-current', 'page');
			else link.removeAttribute('aria-current');
		});

		let expanded = false;
		sidebar.querySelectorAll('button.nav-item[data-nav-toggle]').forEach((button) => {
			if (!(button instanceof HTMLButtonElement)) return;
			const panelId = button.getAttribute('aria-controls');
			const panel = panelId ? document.getElementById(panelId) : null;
			if (!(panel instanceof HTMLElement)) return;
			const selected = panel.querySelector('a.nav-item[aria-current="page"]') != null;
			button.classList.toggle('is-current', selected);
			if (!selected || button.getAttribute('aria-expanded') === 'true') return;
			button.setAttribute('aria-expanded', 'true');
			panel.hidden = false;
			expanded = true;
		});
		if (expanded) saveOpen(sidebar);

		const body = sidebar.querySelector('.sidebar-body');
		const current = sidebar.querySelector('a.nav-item[aria-current="page"]');
		if (!(body instanceof HTMLElement) || !(current instanceof HTMLElement)) return;
		const showCurrent = () => {
			if (body.clientHeight === 0) return;
			const item = current.getBoundingClientRect();
			const top = item.top - body.getBoundingClientRect().top;
			const bottom = top + item.height;
			if (top >= 0 && bottom <= body.clientHeight) return;
			body.scrollTop = Math.max(0, body.scrollTop + top - (body.clientHeight - item.height) / 2);
		};
		showCurrent();
		requestAnimationFrame(showCurrent);
	}

	function bindSidebar(sidebar: HTMLElement) {
		if (boundSidebars.has(sidebar)) return;
		boundSidebars.add(sidebar);
		const themeButtonQuery = sidebar.querySelector('[data-theme-button]');
		const themeButton = themeButtonQuery instanceof HTMLElement ? themeButtonQuery : null;
		const themeMenu = sidebar.querySelector('[data-theme-menu]');

		themeButton?.addEventListener('click', () => {
			if (!(themeMenu instanceof HTMLElement) || !themeButton) return;
			const willOpen = themeMenu.hidden;
			themeMenu.hidden = !willOpen;
			themeButton.setAttribute('aria-expanded', String(willOpen));
		});

		themeMenu?.addEventListener('click', (event) => {
			const item = event.target instanceof Element ? event.target.closest('[data-theme-value]') : null;
			if (!(item instanceof HTMLElement) || !item.dataset.themeValue) return;
			applyTheme(item.dataset.themeValue);
			closeThemeMenu();
			themeButton?.focus();
		});

		sidebar.addEventListener('click', (event) => {
			const button = event.target instanceof Element ? event.target.closest('[data-nav-toggle]') : null;
			if (!(button instanceof HTMLButtonElement)) return;
			const panelId = button.getAttribute('aria-controls');
			const panel = panelId ? document.getElementById(panelId) : null;
			if (!(panel instanceof HTMLElement)) return;
			toggleNav(button, panel);
			saveOpen(sidebar);
		});
	}

	function bootSidebar() {
		const sidebar = document.getElementById('docs-nav');
		if (sidebar instanceof HTMLElement) bindSidebar(sidebar);
		syncThemeUi();
	}

	function toggleNav(button: HTMLButtonElement, panel: HTMLElement) {
		const open = button.getAttribute('aria-expanded') !== 'true';
		button.setAttribute('aria-expanded', String(open));
		const from = panel.getBoundingClientRect().height;
		const running = navAnimations.get(panel);
		if (running) {
			running.onfinish = null;
			running.cancel();
		}
		if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
			panel.hidden = !open;
			panel.style.height = '';
			return;
		}
		if (open) {
			panel.hidden = false;
			panel.style.height = '';
			const height = panel.offsetHeight;
			panel.style.height = `${from}px`;
			const animation = panel.animate([{ height: `${from}px` }, { height: `${height}px` }], {
				duration: 220,
				easing: navEase,
			});
			navAnimations.set(panel, animation);
			animation.onfinish = () => {
				panel.style.height = '';
				animation.cancel();
			};
			return;
		}
		panel.style.height = `${from}px`;
		const animation = panel.animate([{ height: `${from}px` }, { height: '0px' }], {
			duration: 180,
			easing: navEase,
			fill: 'forwards',
		});
		navAnimations.set(panel, animation);
		animation.onfinish = () => {
			panel.hidden = true;
			panel.style.height = '';
			animation.cancel();
		};
	}

	document.addEventListener('click', (event) => {
		if (!(event.target instanceof Node)) return;
		if (event.target instanceof Element && event.target.closest('[data-theme-root]')) return;
		closeThemeMenu();
	});

	matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
		if (root.dataset.theme === 'system') applyTheme('system');
	});

	bootSidebar();
	document.addEventListener('astro:page-load', bootSidebar);
	document.addEventListener('astro:before-swap', (event) => {
		closeThemeMenu();
		const next = 'newDocument' in event && event.newDocument instanceof Document ? event.newDocument.documentElement : null;
		if (!next) return;
		let stored: string | null = null;
		try {
			stored = localStorage.getItem('theme');
		} catch {
			/* storage can be unavailable */
		}
		const theme = stored === 'light' || stored === 'dark' || stored === 'system' ? stored : root.dataset.theme;
		if (!theme) return;
		next.dataset.theme = theme;
		next.dataset.appearance = appearance(theme);
	});
	document.addEventListener('astro:after-swap', () => {
		const sidebar = document.getElementById('docs-nav');
		if (sidebar instanceof HTMLElement) markSidebar(sidebar);
	});
</script>

<style>
	.theme {
		position: relative;
		flex: none;
		padding: 0.75rem 0 1rem;
		background: var(--bg);
	}

	.theme-button {
		display: grid;
		place-items: center;
		width: 2rem;
		height: 2rem;
		border: 1px solid var(--line);
		border-radius: 0.5rem;
		background: var(--bg);
		color: var(--fg);
		cursor: pointer;
	}

	.theme-icon {
		display: none;
	}

	.theme-icon :global(svg) {
		display: block;
		overflow: visible;
	}

	:global(html[data-theme='light']) .theme-icon[data-icon='light'],
	:global(html[data-theme='dark']) .theme-icon[data-icon='dark'],
	:global(html[data-theme='system']) .theme-icon[data-icon='system'],
	:global(html:not([data-theme])) .theme-icon[data-icon='system'] {
		display: inline-flex;
	}

	.theme-menu {
		position: absolute;
		bottom: calc(100% - 0.25rem);
		left: 0;
		z-index: 30;
		min-width: 9.5rem;
		margin: 0;
		padding: 0.25rem;
		border: 1px solid var(--line);
		border-radius: 0.5rem;
		background: var(--bg);
		box-shadow: var(--shadow);
	}

	.theme-menu[hidden] {
		display: none;
	}

	.theme-menu button {
		display: flex;
		align-items: center;
		width: 100%;
		gap: 0.5rem;
		padding: 0.4rem 0.55rem;
		border: 0;
		border-radius: 0.375rem;
		background: transparent;
		color: var(--fg);
		font: inherit;
		text-align: left;
		cursor: pointer;
	}

	.theme-menu button:hover {
		background: var(--fill);
	}

	.check {
		display: inline-flex;
		flex: none;
		margin-left: auto;
		visibility: hidden;
	}

	.check :global(svg) {
		display: block;
		overflow: visible;
	}

	.theme-menu button[aria-checked='true'] .check {
		visibility: visible;
	}

	.theme-button:focus-visible,
	.theme-menu button:focus-visible {
		outline: 2px solid var(--fg);
		outline-offset: 2px;
	}

	.drawer-dashboard {
		display: none;
	}

	@media (max-width: 1023px) {
		.theme-button {
			width: 44px;
			height: 44px;
		}

		.theme-menu button {
			min-height: 44px;
		}
	}

	@media (max-width: 519px) {
		.drawer-dashboard {
			display: flex;
			align-items: center;
			justify-content: center;
			box-sizing: border-box;
			min-height: 44px;
			margin: 0 0 0.75rem;
			padding: 0 0.9rem;
			border-radius: 999px;
			background: oklch(0.32 0 0);
			color: oklch(0.97 0 0);
			font-size: 14px;
			text-decoration: none;
		}

		:global(html[data-appearance='dark']) .drawer-dashboard {
			background: oklch(0.9 0 0);
			color: oklch(0.15 0 0);
		}

		.drawer-dashboard:focus-visible {
			outline: 2px solid var(--fg);
			outline-offset: 2px;
		}
	}
</style>

<script>
	const mobile = matchMedia('(max-width: 1023px)');

	function setOpen(open: boolean, restoreFocus: boolean) {
		const nav = document.getElementById('docs-nav');
		const openButton = document.querySelector('[data-nav-open]');
		const backdrop = document.querySelector('[data-nav-backdrop]');
		const small = mobile.matches;
		const next = small && open;
		document.documentElement.dataset.nav = next ? 'open' : 'closed';
		openButton?.setAttribute('aria-expanded', String(next));
		if (backdrop instanceof HTMLButtonElement) backdrop.hidden = !next;
		if (nav instanceof HTMLElement) {
			nav.inert = small && !next;
			if (next) {
				const first = nav.querySelector('a, button');
				if (first instanceof HTMLElement) first.focus({ preventScroll: true });
			}
		}
		for (const node of document.querySelectorAll('main, .toc')) {
			if (node instanceof HTMLElement) node.inert = next;
		}
		if (!next && restoreFocus && openButton instanceof HTMLElement) openButton.focus();
	}

	setOpen(false, false);

	document.addEventListener('click', (event) => {
		if (!(event.target instanceof Element)) return;
		if (event.target.closest('[data-nav-open]')) {
			setOpen(document.documentElement.dataset.nav !== 'open', false);
			return;
		}
		if (event.target.closest('[data-nav-backdrop]')) {
			setOpen(false, true);
			return;
		}
		const link = event.target.closest('a[href]');
		if (link instanceof HTMLAnchorElement && link.origin === location.origin) setOpen(false, false);
	});

	document.addEventListener('keydown', (event) => {
		if (event.key !== 'Escape' || document.documentElement.dataset.nav !== 'open') return;
		setOpen(false, true);
	});

	mobile.addEventListener('change', () => setOpen(false, false));
	document.addEventListener('astro:after-swap', () => setOpen(false, false));
</script>
