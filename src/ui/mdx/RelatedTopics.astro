---
interface Item {
	title: string;
	href: string;
}

interface Props {
	title?: string;
	items?: Item[];
}

const { title = 'Related pages', items = [] } = Astro.props;
---

{
	items.length > 0 && (
		<nav class="related" aria-label={title}>
			<h2>{title}</h2>
			<ul>
				{items.map((item) => {
					const external = /^https?:\/\//i.test(item.href);
					return (
						<li>
							<a href={item.href} target={external ? '_blank' : undefined} rel={external ? 'noopener noreferrer' : undefined}>
								{item.title}
							</a>
						</li>
					);
				})}
			</ul>
		</nav>
	)
}
