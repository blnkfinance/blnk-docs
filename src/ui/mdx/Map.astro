---
import Icon from './Icon.astro';

interface Props {
	src: string;
	title?: string;
}

const hosts = new Set(['map.blnkfinance.com', 'map.blnkfinance.xyz']);
const { src, title = 'Blnk map' } = Astro.props;

let url: URL | undefined;
try {
	url = new URL(src);
} catch {
	url = undefined;
}

const allowed = url != null && url.protocol === 'https:' && hosts.has(url.hostname);
---

{
	allowed && url && (
		<div class="map">
			<div class="map-canvas">
				<iframe
					src={url.toString()}
					title={title}
					data-blnk-map
					loading="lazy"
					referrerpolicy="no-referrer"
				/>
			</div>
			<a class="map-open" href={url.toString()} target="_blank" rel="noopener noreferrer">
				<Icon icon="external-link" size={16} />
				View full map
			</a>
		</div>
	)
}

<script>
	// Keep embedded maps on the same theme as the docs. The map announces itself
	// with `blnk-map:ready` and switches when it receives `blnk-map:theme`.
	// '*' is deliberate: short links redirect to another origin, and the theme
	// name is not sensitive.
	const THEME = 'blnk-map:theme';
	const READY = 'blnk-map:ready';

	const appearance = () =>
		document.documentElement.dataset.appearance === 'light' ? 'light' : 'dark';
	const frames = () => document.querySelectorAll<HTMLIFrameElement>('iframe[data-blnk-map]');
	const send = (frame: HTMLIFrameElement) =>
		frame.contentWindow?.postMessage({ type: THEME, theme: appearance() }, '*');
	const sendAll = () => frames().forEach(send);

	window.addEventListener('message', (event) => {
		if (event.data?.type !== READY) return;
		for (const frame of frames()) if (frame.contentWindow === event.source) send(frame);
	});

	const watchLoads = () =>
		frames().forEach((frame) => frame.addEventListener('load', () => send(frame)));

	new MutationObserver(sendAll).observe(document.documentElement, {
		attributes: true,
		attributeFilter: ['data-appearance'],
	});
	document.addEventListener('astro:page-load', () => {
		watchLoads();
		sendAll();
	});
</script>
