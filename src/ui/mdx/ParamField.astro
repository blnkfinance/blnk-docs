---
interface Props {
	body?: string;
	query?: string;
	path?: string;
	header?: string;
	type?: string;
	required?: boolean;
	default?: string;
	expanded?: boolean;
}

const { body, query, path, header, type, required, expanded } = Astro.props;
const fallback = Astro.props.default;
const name = body ?? query ?? path ?? header ?? '';
const location = body != null ? 'body' : query != null ? 'query' : path != null ? 'path' : header != null ? 'header' : '';
---

<details class="field" data-kind="param" data-location={location} open={expanded}>
	<summary class="field-line">
		<span class="field-name-group">
			<code class="field-name">{name}</code>
			{type && <span class="field-type">{type}</span>}
		</span>
		<span class="field-meta">
			{fallback != null && fallback !== '' && <span class="field-default">default <code>{fallback}</code></span>}
			{required && <span class="field-required">required</span>}
			{location && <span class="field-location">{location}</span>}
		</span>
	</summary>
	<div class="field-panel">
		<div class="field-body"><slot /></div>
	</div>
</details>

<script>
	import './fields';
</script>
