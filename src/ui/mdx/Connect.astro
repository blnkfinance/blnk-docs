<form class="tutorial-connect" data-action="connect">
	<label class="tutorial-field">
		<span>Core URL</span>
		<input name="baseUrl" type="url" inputmode="url" autocomplete="off" spellcheck="false" placeholder="https://sandbox.example" />
	</label>
	<label class="tutorial-field">
		<span>API key</span>
		<input name="apiKey" type="password" autocomplete="off" spellcheck="false" />
	</label>
	<p class="tutorial-error" data-tutorial-error hidden></p>
	<div class="tutorial-run">
		<button class="tutorial-primary" type="submit" data-run>Run on your sandbox</button>
		<button class="tutorial-secondary" type="button" data-clear hidden>Clear</button>
	</div>
</form>
<div class="tutorial-result" hidden>
	<p>
		Core returned your ledgers, so this URL and key can read the sandbox. An empty list is expected when you have not created a ledger yet. The next step opens the ledger for the customer wallets.
	</p>
	<p class="tutorial-expiry" data-expiry></p>
</div>
