---
interface Props {
	src: string;
	title: string;
}

const { src, title } = Astro.props;
---

<div class="video">
	<iframe
		src={src}
		title={title}
		allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
		allowfullscreen
		loading="lazy"
	></iframe>
</div>
