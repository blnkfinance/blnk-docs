---
interface Props {
	label?: string;
	id?: string;
	method?: string;
	path?: string;
	save?: string;
	response?: string;
}

const { label = 'Submit', id, method, path, save, response } = Astro.props;
---

<form class="tutorial-form" data-tutorial-form data-tutorial-request={id} data-method={method} data-path={path} data-save={save} data-response={response}>
	<slot />
	<button class="tutorial-primary" type="submit">{label}</button>
</form>
