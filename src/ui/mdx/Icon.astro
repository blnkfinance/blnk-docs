---
import { renderIcon } from '../../icons/mingcute';

interface Props {
	icon: string;
	size?: number;
	color?: string;
}

const { icon, size = 16, color = 'currentColor' } = Astro.props;
const image = icon.startsWith('/') || icon.startsWith('./');
const svg = image ? '' : await renderIcon(icon, size);
---

<span class="icon" style={`color: ${color}; width: ${size}px; height: ${size}px`}>
	{
		image ? (
			<img src={icon} alt="" width={size} height={size} />
		) : svg ? (
			<Fragment set:html={svg} />
		) : (
			<span class="icon-missing">{icon}</span>
		)
	}
</span>
