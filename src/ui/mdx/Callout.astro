---
import Icon from './Icon.astro';

interface Props {
	tone: 'note' | 'info' | 'tip' | 'warning' | 'check';
	label?: string;
}

const { tone, label } = Astro.props;

const icons = {
	note: 'information',
	info: 'information',
	tip: 'bulb',
	warning: 'alert',
	check: 'check-circle',
} as const;
---

<aside class:list={['callout', `callout-${tone}`]}>
	{label && (
		<p class="callout-label">
			<Icon icon={icons[tone]} size={14} />
			{label}
		</p>
	)}
	<div class="callout-body"><slot /></div>
</aside>
