---
import Icon from './Icon.astro';

interface Props {
	tone: 'note' | 'info' | 'tip' | 'warning' | 'check';
	label?: string;
}

const { tone, label } = Astro.props;

const defaults = {
	note: 'Note',
	info: 'Info',
	tip: 'Tip',
	warning: 'Warning',
	check: 'Check',
} as const;

const icons = {
	note: 'information',
	info: 'information',
	tip: 'bulb',
	warning: 'alert',
	check: 'check-circle',
} as const;

const heading = (label ?? defaults[tone]).trim();
const showLabel = heading.length > 0;
---

<aside class:list={['callout', `callout-${tone}`, showLabel && 'has-label']}>
	{
		showLabel && (
			<p class="callout-label">
				<Icon icon={icons[tone]} size={14} />
				<span>{heading}</span>
			</p>
		)
	}
	<div class="callout-body"><slot /></div>
</aside>
