<script>
	import copyRaw from '../../icons/line/copy-2.svg?raw';
	import checkRaw from '../../icons/line/check.svg?raw';
	import { prepareSvg } from '../../icons/prepare';

	const copyIcon = prepareSvg(copyRaw, 16);
	const copiedIcon = prepareSvg(checkRaw, 16);

	function codeLabel(pre: HTMLElement) {
		return pre.dataset.title || pre.dataset.language || 'Code';
	}

	function addTitle(pre: HTMLElement) {
		if (pre.closest('[data-code-group]') || pre.closest('.code-frame')) return;
		const frame = document.createElement('div');
		frame.className = 'code-frame';
		const title = document.createElement('div');
		title.className = 'code-title';
		title.textContent = codeLabel(pre);
		pre.replaceWith(frame);
		frame.append(title, pre);
	}

	function addCopy(pre: HTMLElement) {
		if (pre.closest('.example')) return;
		if (pre.querySelector('.code-copy')) return;
		const button = document.createElement('button');
		button.type = 'button';
		button.className = 'code-copy';
		button.setAttribute('aria-label', 'Copy code');
		button.innerHTML = copyIcon;
		let reset = 0;
		button.addEventListener('click', async () => {
			const code = pre.querySelector('code');
			await navigator.clipboard.writeText(code?.textContent ?? '');
			button.setAttribute('aria-label', 'Copied');
			button.innerHTML = copiedIcon;
			window.clearTimeout(reset);
			reset = window.setTimeout(() => {
				button.setAttribute('aria-label', 'Copy code');
				button.innerHTML = copyIcon;
			}, 2000);
		});
		pre.append(button);
	}

	const collapsedLines = 12;
	const ease = 'cubic-bezier(0.23, 1, 0.32, 1)';

	function lineCount(pre: HTMLElement) {
		const lines = pre.querySelectorAll('.line').length;
		if (lines > 0) return lines;
		const text = pre.querySelector('code')?.textContent ?? '';
		return text ? text.split('\n').length : 0;
	}

	function collapsed(element: HTMLElement) {
		return element.hidden !== false;
	}

	function collapse(pre: HTMLElement, isHidden: () => boolean = () => collapsed(pre)) {
		if (pre.dataset.collapsed || lineCount(pre) <= collapsedLines) return;
		pre.dataset.collapsed = 'true';
		pre.classList.add('is-collapsed');
		const button = document.createElement('button');
		button.type = 'button';
		button.className = 'code-expand';
		button.textContent = 'Show more';
		let animation: Animation | undefined;

		function release() {
			pre.style.height = '';
			pre.style.maxHeight = '';
			pre.style.overflow = '';
			pre.style.boxSizing = '';
		}

		button.addEventListener('click', () => {
			const from = pre.getBoundingClientRect().height;
			if (animation) {
				animation.onfinish = null;
				animation.cancel();
			}
			release();
			const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
			const opening = pre.classList.contains('is-collapsed');
			pre.classList.toggle('is-collapsed', !opening);
			button.textContent = opening ? 'Show less' : 'Show more';
			if (reduce) return;
			const to = pre.offsetHeight;
			pre.style.boxSizing = 'border-box';
			pre.style.overflow = 'hidden';
			pre.style.maxHeight = 'none';
			pre.style.height = `${from}px`;
			animation = pre.animate([{ height: `${from}px` }, { height: `${to}px` }], {
				duration: opening ? 220 : 180,
				easing: ease,
				fill: 'forwards',
			});
			animation.onfinish = () => {
				release();
				animation?.cancel();
				animation = undefined;
			};
		});
		pre.after(button);
		const sync = () => {
			button.hidden = isHidden();
		};
		sync();
		return sync;
	}

	const idPattern = /\{[A-Za-z_][A-Za-z0-9_]*\}/g;

	function highlightIds(root: ParentNode) {
		const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
		const nodes: Text[] = [];
		while (walker.nextNode()) {
			const node = walker.currentNode;
			if (node instanceof Text) nodes.push(node);
		}
		for (const node of nodes) {
			const text = node.textContent ?? '';
			if (!idPattern.test(text)) {
				idPattern.lastIndex = 0;
				continue;
			}
			idPattern.lastIndex = 0;
			const parent = node.parentElement;
			if (!parent || parent.classList.contains('code-id') || parent.closest('script, style')) continue;
			const fragment = document.createDocumentFragment();
			let last = 0;
			for (const match of text.matchAll(idPattern)) {
				const index = match.index ?? 0;
				if (index > last) fragment.append(text.slice(last, index));
				const mark = document.createElement('span');
				mark.className = 'code-id';
				mark.textContent = match[0];
				fragment.append(mark);
				last = index + match[0].length;
			}
			if (last < text.length) fragment.append(text.slice(last));
			node.replaceWith(fragment);
		}
	}

	function enhanceCodeBlocks() {
		document.querySelectorAll('.article pre').forEach((pre) => highlightIds(pre));

		document.querySelectorAll('[data-example="request"], [data-example="response"]').forEach((example) => {
			if (!(example instanceof HTMLElement)) return;
			const pres = [...example.children].filter(
				(node): node is HTMLElement => node instanceof HTMLElement && node.tagName === 'PRE',
			);
			if (pres.length < 2) return;
			const group = document.createElement('div');
			group.className = 'code-group';
			group.setAttribute('data-code-group', '');
			pres[0].before(group);
			pres.forEach((pre) => group.append(pre));
		});

		document.querySelectorAll('[data-code-group]').forEach((group) => {
			if (!(group instanceof HTMLElement) || group.dataset.ready) return;
			const pres = [...group.querySelectorAll(':scope > pre')].filter(
				(node): node is HTMLElement => node instanceof HTMLElement,
			);
			if (pres.length === 0) return;
			group.dataset.ready = 'true';
			const bar = document.createElement('div');
			bar.className = 'code-group-bar';
			bar.setAttribute('role', 'tablist');
			const stack = document.createElement('div');
			stack.className = 'code-group-stack';
			const panels: HTMLElement[] = [];
			const syncExpand: Array<() => void> = [];
			let motion: Animation[] = [];

			function stopMotion() {
				motion.forEach((animation) => {
					animation.onfinish = null;
					animation.cancel();
				});
				motion = [];
				panels.forEach((panel) => {
					panel.style.position = '';
					panel.style.inset = '';
					panel.style.opacity = '';
				});
				stack.style.height = '';
			}

			function shownPanel() {
				return panels.find((panel) => panel.style.position === 'absolute') ?? panels.find((panel) => !panel.hidden);
			}

			function select(index: number) {
				const next = panels[index];
				bar.querySelectorAll('.code-group-tab').forEach((item, itemIndex) => {
					item.setAttribute('aria-selected', itemIndex === index ? 'true' : 'false');
				});
				const incoming = panels.find((panel) => panel.style.position === 'absolute');
				stopMotion();
				if (incoming) {
					panels.forEach((panel) => {
						panel.hidden = panel !== incoming;
					});
				}
				const current = shownPanel();
				if (!next || current === next) return;
				const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
				if (!current || reduce) {
					panels.forEach((panel) => {
						panel.hidden = panel !== next;
					});
					syncExpand.forEach((sync) => sync());
					return;
				}
				const from = current.offsetHeight;
				next.hidden = false;
				syncExpand.forEach((sync) => sync());
				const to = next.offsetHeight;
				next.style.position = 'absolute';
				next.style.inset = '0 0 auto';
				next.style.opacity = '0';
				stack.style.height = `${from}px`;
				const height = stack.animate([{ height: `${from}px` }, { height: `${to}px` }], {
					duration: 200,
					easing: ease,
					fill: 'forwards',
				});
				const fadeOut = current.animate([{ opacity: 1 }, { opacity: 0 }], {
					duration: 160,
					easing: ease,
					fill: 'forwards',
				});
				const fadeIn = next.animate([{ opacity: 0 }, { opacity: 1 }], {
					duration: 200,
					easing: ease,
					fill: 'forwards',
				});
				motion = [height, fadeOut, fadeIn];
				fadeIn.onfinish = () => {
					current.hidden = true;
					stopMotion();
					syncExpand.forEach((sync) => sync());
				};
			}

			pres.forEach((pre, index) => {
				const panel = document.createElement('div');
				panel.className = 'code-group-panel';
				panel.hidden = index !== 0;
				pre.replaceWith(panel);
				panel.append(pre);
				stack.append(panel);
				panels.push(panel);
				const button = document.createElement('button');
				button.type = 'button';
				button.className = 'code-group-tab';
				button.setAttribute('role', 'tab');
				button.textContent = codeLabel(pre);
				button.setAttribute('aria-selected', index === 0 ? 'true' : 'false');
				button.addEventListener('click', () => select(index));
				bar.append(button);
				const sync = collapse(pre, () => collapsed(panel));
				if (sync) syncExpand.push(sync);
			});
			group.append(stack);
			group.prepend(bar);
		});

		document.querySelectorAll('.article pre').forEach((pre) => {
			if (!(pre instanceof HTMLElement) || pre.closest('[data-code-group]')) return;
			if (pre.closest('.example') || pre.dataset.title) addTitle(pre);
			collapse(pre);
		});

		document.querySelectorAll('.article pre').forEach((pre) => {
			if (pre instanceof HTMLElement) addCopy(pre);
		});
	}

	(window as Window & { enhanceCodeBlocks?: () => void }).enhanceCodeBlocks = enhanceCodeBlocks;
	enhanceCodeBlocks();
	document.addEventListener('astro:page-load', enhanceCodeBlocks);
</script>
