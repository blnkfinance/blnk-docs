---
interface Props {
	label: string;
	description?: string;
}

const { label, description } = Astro.props;
---

<article class="update">
	<header class="update-header">
		<span class="update-label">{label}</span>
		{description && <span class="update-description">{description}</span>}
	</header>
	<div class="update-body"><slot /></div>
</article>
