---
interface Props {
	id: string;
	method: 'GET' | 'POST' | 'PUT' | 'PATCH' | 'DELETE';
	path: string;
	save?: string;
	response?: string;
}

const { id, method, path, save, response } = Astro.props;
---

<form class="tutorial-action" data-view="form" data-action={id} data-method={method} data-path={path} data-save={save} data-response={response ?? save}>
	<div class="tutorial-views" role="tablist" aria-label="Request">
		<button type="button" data-tutorial-view="form" aria-selected="true">Form</button>
		<button type="button" data-tutorial-view="code" aria-selected="false">Code</button>
	</div>
	<p class="tutorial-same">Form and code are the same request.</p>
	<div class="tutorial-action-body">
		<slot />
	</div>
	<p class="tutorial-error" data-tutorial-error hidden></p>
	<button class="tutorial-primary" type="submit" data-run>Run on your sandbox</button>
</form>
