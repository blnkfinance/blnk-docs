---
import Icon from './Icon.astro';

interface Props {
	href: string;
	icon: string;
	label: string;
}

const { href, icon, label } = Astro.props;
const image = icon.startsWith('/');
---

<a class="home-action" href={href}>
	<span class:list={['home-action-icon', { 'home-action-icon-sdk': image }]}>
		{image ? <img src={icon} alt="" width="16" height="16" /> : <Icon icon={icon} size={16} />}
	</span>
	<span class="home-action-copy">
		<span class="home-action-label">{label}</span>
		<span class="home-action-desc"><slot /></span>
	</span>
</a>
