---
import Icon from './Icon.astro';

interface Props {
	title: string;
	icon?: string;
}

const { title, icon } = Astro.props;
---

<div class="tab" data-title={title}>
	<span class="tab-label" hidden>
		{icon && <Icon icon={icon} size={14} />}
		{title}
	</span>
	<div class="tab-panel"><slot /></div>
</div>
