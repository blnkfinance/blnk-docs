---
interface Props {
	name: string;
	type?: string;
	required?: boolean;
	expanded?: boolean;
}

const { name, type, required, expanded } = Astro.props;
---

<details class="field" data-kind="response" open={expanded}>
	<summary class="field-line">
		<span class="field-name-group">
			<code class="field-name">{name}</code>
			{type && <span class="field-type">{type}</span>}
		</span>
		{required && (
			<span class="field-meta">
				<span class="field-required">required</span>
			</span>
		)}
	</summary>
	<div class="field-panel">
		<div class="field-body"><slot /></div>
	</div>
</details>

<script>
	import './fields';
</script>
