---
import type { MarkdownHeading } from 'astro';
import { Font } from 'astro:assets';
import { currentTab, navigation, pageLabel } from '../content/nav';
import '../styles/styles.css';
import '../styles/mdx.css';
import Header from './Header.astro';
import CodeBlocks from './mdx/CodeBlocks.astro';
import Nav from './Nav.astro';
import Toc from './Toc.astro';

interface Props {
	title: string;
	description: string;
	headings: MarkdownHeading[];
	markdown: string;
}

const { title, description, headings, markdown } = Astro.props;
const section = currentTab(navigation, Astro.url.pathname);
const sectionName = section && 'tab' in section ? section.tab : '';
const label = pageLabel(navigation, Astro.url.pathname);
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<script is:inline>
			(() => {
				const stored = localStorage.getItem('theme');
				const theme = stored === 'light' || stored === 'dark' || stored === 'system' ? stored : 'system';
				const dark =
					theme === 'dark' ||
					(theme === 'system' && matchMedia('(prefers-color-scheme: dark)').matches);
				const root = document.documentElement;
				root.dataset.theme = theme;
				root.dataset.appearance = dark ? 'dark' : 'light';
			})();
		</script>
		<link rel="icon" href="/favicon.png" type="image/png" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<Font cssVariable="--font-graphik" preload />
		<Font cssVariable="--font-geist-mono" />
	</head>
	<body>
		<div class="frame">
			<Header />
			<div class="shell">
				<Nav />
				<main>
					<article
						class="article"
						data-pagefind-body
						data-pagefind-meta={sectionName ? `section:${sectionName}` : undefined}
					>
						<p class="kicker">{label}</p>
						<h1 data-pagefind-meta={`title, description:${description}`}>{title}</h1>
						<slot />
					</article>
				</main>
				<Toc headings={headings} markdown={markdown} />
			</div>
			<CodeBlocks />
		</div>
	</body>
</html>
