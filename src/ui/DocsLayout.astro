---
import type { MarkdownHeading } from 'astro';
import { Font } from 'astro:assets';
import { getCollection } from 'astro:content';
import { breadcrumbs, currentTab, methodLabel, navigation, pageHref, pageLabel, type Crumb } from './navigation';
import {
	absoluteUrl,
	canonicalPath,
	markdownPath,
	ogImageAlt,
	ogImageHeight,
	ogImagePath,
	ogImageWidth,
	requireSite,
	siteName,
} from '../lib/seo';
import '../styles/styles.css';
import '../styles/mdx.css';
import { renderIcon } from '../icons/mingcute';
import { ClientRouter } from 'astro:transitions';
import Analytics from './Analytics.astro';
import Header from './Header.astro';
import CodeBlocks from './mdx/CodeBlocks.astro';
import Nav from './Nav.astro';
import Toc from './Toc.astro';
import TutorialBanner from './TutorialBanner.astro';

interface Props {
	title: string;
	documentTitle: string;
	description: string;
	indexable: boolean;
	headings: MarkdownHeading[];
	markdown: string;
	lede?: string;
	method?: string;
	endpoint?: string;
	enterprise?: string;
	toc?: boolean;
	tutorial?: boolean;
	steps?: { id: string; title: string }[];
}

const { title, documentTitle, description, indexable, headings, markdown, lede, method, endpoint, enterprise, toc = true, tutorial = false, steps } =
	Astro.props;
const notice = enterprise?.trim();
const play = method && endpoint ? await renderIcon('play', 14) : '';
const enterpriseIcon = notice ? await renderIcon('building-1', 16) : '';
const pageDescription = lede?.trim();
const site = requireSite(Astro.site);
const path = canonicalPath(Astro.url.pathname);
const sdkMethod = path.startsWith('/sdks/') && method != null;
const canonical = absoluteUrl(path, site);
const image = absoluteUrl(ogImagePath, site);
const section = currentTab(navigation, path);
const sectionName = section && 'tab' in section ? section.tab : '';
const hrefs = new Set((await getCollection('docs')).map((entry) => pageHref(entry.id)));
const crumbs = breadcrumbs(navigation, path, title, hrefs);
const label = pageLabel(navigation, path);
const markdownHref = absoluteUrl(markdownPath(path), site);
const jsonLd = structuredData({ title: documentTitle, description, canonical, image, crumbs });

function structuredData(page: {
	title: string;
	description: string;
	canonical: string;
	image: string;
	crumbs: Crumb[];
}): string {
	const graph: Record<string, unknown>[] = [
		{
			'@type': 'WebPage',
			name: page.title,
			description: page.description,
			url: page.canonical,
			image: page.image,
		},
	];
	const items: Record<string, unknown>[] = [];
	for (const [index, crumb] of page.crumbs.entries()) {
		const isLast = index === page.crumbs.length - 1;
		const href = isLast ? page.canonical : crumb.href ? absoluteUrl(crumb.href, site) : undefined;
		if (!href) continue;
		items.push({
			'@type': 'ListItem',
			position: items.length + 1,
			name: crumb.name,
			item: href,
		});
	}
	if (items.length > 0) {
		graph.push({
			'@type': 'BreadcrumbList',
			itemListElement: items,
		});
	}
	return JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(/</g, '\\u003c');
}
---

<html lang="en" transition:animate="none">
	<head>
		<meta charset="utf-8" />
		<ClientRouter />
		<script is:inline>
			(() => {
				const stored = localStorage.getItem('theme');
				const theme = stored === 'light' || stored === 'dark' || stored === 'system' ? stored : 'system';
				const dark =
					theme === 'dark' ||
					(theme === 'system' && matchMedia('(prefers-color-scheme: dark)').matches);
				const root = document.documentElement;
				root.dataset.theme = theme;
				root.dataset.appearance = dark ? 'dark' : 'light';
			})();
		</script>
		<script is:inline>
			(() => {
				if (window.__blnkCoreSession) return;
				window.__blnkCoreSession = true;
				const coreKey = 'blnk.core';
				const holdKey = 'blnk.core.hold';
				const prefix = 'blnk.core.tab.';
				let id = '';
				try {
					id = crypto.randomUUID();
				} catch {
					id = String(Date.now()) + Math.random().toString(16).slice(2);
				}
				const tabKey = prefix + id;
				const staleAfter = 24 * 60 * 60 * 1000;
				let timer = 0;

				function restoreHold() {
					const hold = sessionStorage.getItem(holdKey);
					if (!hold) return false;
					if (!localStorage.getItem(coreKey)) localStorage.setItem(coreKey, hold);
					sessionStorage.removeItem(holdKey);
					return true;
				}

				function tabKeys() {
					const keys = [];
					for (let index = 0; index < localStorage.length; index += 1) {
						const item = localStorage.key(index);
						if (item && item.startsWith(prefix)) keys.push(item);
					}
					return keys;
				}

				function prune() {
					const now = Date.now();
					for (const item of tabKeys()) {
						if (item === tabKey) continue;
						const seen = Number(localStorage.getItem(item));
						if (!Number.isFinite(seen) || now - seen > staleAfter) localStorage.removeItem(item);
					}
				}

				function otherTabs() {
					prune();
					return tabKeys().some((item) => item !== tabKey);
				}

				function touch() {
					localStorage.setItem(tabKey, String(Date.now()));
				}

				function start() {
					touch();
					if (timer) return;
					timer = window.setInterval(touch, 5000);
				}

				function leave() {
					if (timer) {
						window.clearInterval(timer);
						timer = 0;
					}
					localStorage.removeItem(tabKey);
					if (otherTabs()) return;
					const core = localStorage.getItem(coreKey);
					if (core) sessionStorage.setItem(holdKey, core);
					localStorage.removeItem(coreKey);
				}

				try {
					if (!restoreHold() && !otherTabs()) localStorage.removeItem(coreKey);
					start();
				} catch {
					return;
				}

				window.addEventListener('pagehide', () => {
					try {
						leave();
					} catch {
						/* ignore */
					}
				});
				window.addEventListener('pageshow', (event) => {
					if (!event.persisted) return;
					try {
						restoreHold();
						start();
					} catch {
						/* ignore */
					}
				});
			})();
		</script>
		<link rel="icon" href="/favicon.png" type="image/png" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="generator" content={Astro.generator} />
		<title>{documentTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<meta name="robots" content={indexable ? 'index, follow' : 'noindex, follow'} />
		<meta property="og:title" content={documentTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:type" content={path === '/' ? 'website' : 'article'} />
		<meta property="og:site_name" content={siteName} />
		<meta property="og:locale" content="en_US" />
		<meta property="og:image" content={image} />
		<meta property="og:image:width" content={String(ogImageWidth)} />
		<meta property="og:image:height" content={String(ogImageHeight)} />
		<meta property="og:image:alt" content={ogImageAlt} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={documentTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={image} />
		<meta name="twitter:image:width" content={String(ogImageWidth)} />
		<meta name="twitter:image:height" content={String(ogImageHeight)} />
		<meta name="twitter:image:alt" content={ogImageAlt} />
		{indexable && <link rel="alternate" type="text/markdown" href={markdownHref} />}
		<script type="application/ld+json" set:html={jsonLd} />
		<Font cssVariable="--font-graphik" preload />
		<Font cssVariable="--font-geist-mono" />
		<Analytics />
	</head>
	<body data-pagefind-ignore={indexable ? undefined : 'all'}>
		<div class="frame">
			<Header />
			{
				notice && (
					<p class="enterprise">
						{enterpriseIcon && <Fragment set:html={enterpriseIcon} />}
						<span>{notice}</span>
					</p>
				)
			}
			{tutorial && <TutorialBanner />}
			<div class:list={['shell', { 'sdk-method': sdkMethod, tutorial: !toc }]}>
				<Nav />
				<main>
					<article
						class={path.startsWith('/sdks') ? 'article sdk-page' : 'article'}
						data-pagefind-body={indexable ? '' : undefined}
						data-pagefind-meta={indexable && sectionName ? `section:${sectionName}` : undefined}
					>
						{label && <p class="page-label">{label}</p>}
						<h1 data-pagefind-meta={indexable ? `title, description:${description}` : undefined}>{title}</h1>
						{pageDescription && <p class="page-description">{pageDescription}</p>}
						{
							method && endpoint && (
								<div class="endpoint">
									<span class="method" data-method={method}>
										{methodLabel(method)}
									</span>
									<code class="endpoint-path">{endpoint.split(/(\{[^}]+\})/).map((part) => part.startsWith('{') ? <span class="endpoint-param">{part}</span> : part)}</code>
									<button type="button" class="endpoint-try">
										<Fragment set:html={play} />
										Try it
									</button>
								</div>
							)
						}
						<slot />
						<script is:inline data-astro-rerun>
							(() => {
								const script = document.currentScript;
								const article =
									script?.parentElement instanceof HTMLElement
										? script.parentElement
										: document.querySelector('article:not(.has-examples)');
								if (!(article instanceof HTMLElement) || article.classList.contains('has-examples')) return;
								const examples = [...article.querySelectorAll(':scope > .example')];
								if (examples.length === 0) return;
								const copy = document.createElement('div');
								copy.className = 'article-copy';
								const rail = document.createElement('div');
								rail.className = 'article-examples';
								for (const node of [...article.childNodes]) {
									if (node === document.currentScript) continue;
									if (node instanceof Element && node.classList.contains('example')) rail.append(node);
									else copy.append(node);
								}
								article.prepend(copy, rail);
								article.classList.add('has-examples');
							})();
						</script>
					</article>
				</main>
				{toc && <Toc headings={headings} markdown={markdown} sections={!sdkMethod} steps={steps} />}
			</div>
			<CodeBlocks />
		</div>
	</body>
</html>
