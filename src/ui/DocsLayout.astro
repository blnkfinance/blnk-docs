---
import { Font } from 'astro:assets';
import Nav from './Nav.astro';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" href="/favicon.png" type="image/png" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<Font cssVariable="--font-graphik" preload />
	</head>
	<body>
		<div class="shell">
			<Nav />
			<main>
				<slot />
			</main>
		</div>
	</body>
</html>

<style is:global>
	html {
		font-family: var(--font-graphik);
		font-size: 14px;
		line-height: 1.5;
		font-weight: 400;
		font-synthesis: none;
	}

	body {
		margin: 0;
	}

	strong,
	b {
		font-weight: 500;
	}

	.shell {
		display: grid;
		grid-template-columns: 16rem 1fr;
		min-height: 100vh;
	}

	nav {
		padding: 1.5rem;
	}

	main {
		padding: 1.5rem 2rem;
	}
</style>
