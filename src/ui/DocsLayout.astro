---
import type { MarkdownHeading } from 'astro';
import { Font } from 'astro:assets';
import { breadcrumbs, currentTab, navigation, pageLabel, type Crumb } from './navigation';
import {
	absoluteUrl,
	canonicalPath,
	markdownPath,
	ogImageAlt,
	ogImageHeight,
	ogImagePath,
	ogImageWidth,
	requireSite,
	siteName,
} from '../lib/seo';
import '../styles/styles.css';
import '../styles/mdx.css';
import Header from './Header.astro';
import CodeBlocks from './mdx/CodeBlocks.astro';
import Nav from './Nav.astro';
import Toc from './Toc.astro';

interface Props {
	title: string;
	documentTitle: string;
	description: string;
	indexable: boolean;
	headings: MarkdownHeading[];
	markdown: string;
	lede?: string;
}

const { title, documentTitle, description, indexable, headings, markdown, lede } = Astro.props;
const pageDescription = lede?.trim();
const site = requireSite(Astro.site);
const path = canonicalPath(Astro.url.pathname);
const canonical = absoluteUrl(path, site);
const image = absoluteUrl(ogImagePath, site);
const section = currentTab(navigation, path);
const sectionName = section && 'tab' in section ? section.tab : '';
const crumbs = breadcrumbs(navigation, path, title);
const label = pageLabel(navigation, path);
const markdownHref = absoluteUrl(markdownPath(path), site);
const jsonLd = structuredData({ title: documentTitle, description, canonical, image, crumbs });

function structuredData(page: {
	title: string;
	description: string;
	canonical: string;
	image: string;
	crumbs: Crumb[];
}): string {
	const graph: Record<string, unknown>[] = [
		{
			'@type': 'WebPage',
			name: page.title,
			description: page.description,
			url: page.canonical,
			image: page.image,
		},
	];
	const items: Record<string, unknown>[] = [];
	for (const [index, crumb] of page.crumbs.entries()) {
		const isLast = index === page.crumbs.length - 1;
		const href = isLast ? page.canonical : crumb.href ? absoluteUrl(crumb.href, site) : undefined;
		if (!href) continue;
		items.push({
			'@type': 'ListItem',
			position: items.length + 1,
			name: crumb.name,
			item: href,
		});
	}
	if (items.length > 0) {
		graph.push({
			'@type': 'BreadcrumbList',
			itemListElement: items,
		});
	}
	return JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(/</g, '\\u003c');
}
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<script is:inline>
			(() => {
				const stored = localStorage.getItem('theme');
				const theme = stored === 'light' || stored === 'dark' || stored === 'system' ? stored : 'system';
				const dark =
					theme === 'dark' ||
					(theme === 'system' && matchMedia('(prefers-color-scheme: dark)').matches);
				const root = document.documentElement;
				root.dataset.theme = theme;
				root.dataset.appearance = dark ? 'dark' : 'light';
			})();
		</script>
		<link rel="icon" href="/favicon.png" type="image/png" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{documentTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<meta name="robots" content={indexable ? 'index, follow' : 'noindex, follow'} />
		<meta property="og:title" content={documentTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:type" content={path === '/' ? 'website' : 'article'} />
		<meta property="og:site_name" content={siteName} />
		<meta property="og:locale" content="en_US" />
		<meta property="og:image" content={image} />
		<meta property="og:image:width" content={String(ogImageWidth)} />
		<meta property="og:image:height" content={String(ogImageHeight)} />
		<meta property="og:image:alt" content={ogImageAlt} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={documentTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={image} />
		<meta name="twitter:image:width" content={String(ogImageWidth)} />
		<meta name="twitter:image:height" content={String(ogImageHeight)} />
		<meta name="twitter:image:alt" content={ogImageAlt} />
		{indexable && <link rel="alternate" type="text/markdown" href={markdownHref} />}
		<script type="application/ld+json" set:html={jsonLd} />
		<Font cssVariable="--font-graphik" preload />
		<Font cssVariable="--font-geist-mono" />
	</head>
	<body data-pagefind-ignore={indexable ? undefined : 'all'}>
		<div class="frame">
			<Header />
			<div class="shell">
				<Nav />
				<main>
					<article
						class="article"
						data-pagefind-body={indexable ? '' : undefined}
						data-pagefind-meta={indexable && sectionName ? `section:${sectionName}` : undefined}
					>
						{label && <p class="page-label">{label}</p>}
						<h1 data-pagefind-meta={indexable ? `title, description:${description}` : undefined}>{title}</h1>
						{pageDescription && <p class="page-description">{pageDescription}</p>}
						<slot />
					</article>
				</main>
				<Toc headings={headings} markdown={markdown} />
			</div>
			<CodeBlocks />
		</div>
	</body>
</html>
