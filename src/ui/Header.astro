---
import logoLight from '../content/images/dev-light-mode.svg?url';
import logoDark from '../content/images/dev-dark-mode.svg?url';
import { currentTab, navigation } from '../content/nav';

const root = navigation.navigation.root;
const tabs = navigation.navigation.tabs;
const current = currentTab(navigation, Astro.url.pathname)?.path;
---

<header class="header">
	<div class="start">
		<nav class="tabs" aria-label="Primary">
			<a class="logo" href={root.path} aria-current={root.path === current ? 'page' : undefined}>
				<img
					class="logo-light"
					src={logoLight}
					alt="blnk | Developer"
					width="192"
					height="28"
				/>
				<img class="logo-dark" src={logoDark} alt="" width="192" height="28" />
			</a>
			{
				tabs.map((tab) => (
					<a href={tab.path} aria-current={tab.path === current ? 'page' : undefined}>
						{tab.tab}
					</a>
				))
			}
		</nav>
	</div>

	<button
		class="search"
		type="button"
		aria-haspopup="dialog"
		aria-keyshortcuts="Meta+K Control+K"
		data-search-open
	>
		<svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true">
			<circle cx="7" cy="7" r="4.25" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
			<path d="M10.2 10.2 13.5 13.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
		</svg>
		<span>Search</span>
		<kbd data-search-kbd>⌘K</kbd>
	</button>

	<div class="end">
		<div class="theme" data-theme-root>
			<button
				class="theme-button"
				type="button"
				aria-haspopup="menu"
				aria-expanded="false"
				aria-label="Theme"
				data-theme-button
			>
				<svg class="theme-icon" data-icon="light" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
					<circle cx="8" cy="8" r="2.25" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
					<path
						d="M8 1.5v1.5M8 13v1.5M1.5 8H3M13 8h1.5M3.2 3.2l1.1 1.1M11.7 11.7l1.1 1.1M3.2 12.8l1.1-1.1M11.7 4.3l1.1-1.1"
						fill="none"
						stroke="currentColor"
						stroke-width="1.5"
						stroke-linecap="round"></path>
				</svg>
				<svg class="theme-icon" data-icon="dark" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
					<path
						d="M10.2 2.2a5.2 5.2 0 1 0 3.6 8.8 4.4 4.4 0 0 1-3.6-8.8Z"
						fill="none"
						stroke="currentColor"
						stroke-width="1.5"
						stroke-linejoin="round"></path>
				</svg>
				<svg class="theme-icon" data-icon="system" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
					<rect x="2" y="2.5" width="12" height="8.5" rx="1.25" fill="none" stroke="currentColor" stroke-width="1.5"></rect>
					<path d="M6 13.5h4M8 11v2.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
				</svg>
			</button>
			<div class="theme-menu" role="menu" hidden data-theme-menu>
				<button type="button" role="menuitemradio" data-theme-value="light" aria-checked="false">
					Light
					<svg class="check" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
						<path d="M3.5 8.5 6.5 11.5 12.5 4.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
					</svg>
				</button>
				<button type="button" role="menuitemradio" data-theme-value="dark" aria-checked="false">
					Dark
					<svg class="check" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
						<path d="M3.5 8.5 6.5 11.5 12.5 4.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
					</svg>
				</button>
				<button type="button" role="menuitemradio" data-theme-value="system" aria-checked="false">
					System
					<svg class="check" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
						<path d="M3.5 8.5 6.5 11.5 12.5 4.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
					</svg>
				</button>
			</div>
		</div>
	</div>
</header>

<dialog class="search-dialog" aria-label="Search" data-search-dialog>
	<div class="search-row">
		<svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true">
			<circle cx="7" cy="7" r="4.25" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
			<path d="M10.2 10.2 13.5 13.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
		</svg>
		<input type="search" placeholder="Search docs" autocomplete="off" spellcheck="false" data-search-input />
	</div>
	<p class="search-empty" hidden data-search-empty>No matching pages.</p>
</dialog>

<script>
	const root = document.documentElement;
	const openButton = document.querySelector('[data-search-open]');
	const dialog = document.querySelector('[data-search-dialog]');
	const input = document.querySelector('[data-search-input]');
	const empty = document.querySelector('[data-search-empty]');
	const kbd = document.querySelector('[data-search-kbd]');
	const themeRoot = document.querySelector('[data-theme-root]');
	const themeButton = document.querySelector('[data-theme-button]');
	const themeMenu = document.querySelector('[data-theme-menu]');
	const tabs = document.querySelectorAll('.tabs a');

	const mac = /\bMac|iPhone|iPad/.test(navigator.userAgent);
	if (kbd) kbd.textContent = mac ? '⌘K' : 'Ctrl K';

	function appearance(theme) {
		if (theme === 'dark') return 'dark';
		if (theme === 'light') return 'light';
		return matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
	}

	function syncThemeUi() {
		const theme = root.dataset.theme ?? 'system';
		if (themeButton) themeButton.setAttribute('aria-label', `Theme, ${theme}`);
		themeMenu?.querySelectorAll('[data-theme-value]').forEach((item) => {
			item.setAttribute('aria-checked', String(item.dataset.themeValue === theme));
		});
	}

	function applyTheme(theme) {
		root.dataset.theme = theme;
		root.dataset.appearance = appearance(theme);
		localStorage.setItem('theme', theme);
		syncThemeUi();
	}

	function closeThemeMenu() {
		if (!themeMenu || themeMenu.hidden) return;
		themeMenu.hidden = true;
		themeButton?.setAttribute('aria-expanded', 'false');
	}

	function openSearch() {
		if (!(dialog instanceof HTMLDialogElement) || !(input instanceof HTMLInputElement)) return;
		closeThemeMenu();
		if (input.value) {
			input.value = '';
			empty?.setAttribute('hidden', '');
		}
		if (!dialog.open) dialog.showModal();
		input.focus();
	}

	function closeSearch() {
		if (dialog instanceof HTMLDialogElement && dialog.open) dialog.close();
	}

	openButton?.addEventListener('click', openSearch);

	input?.addEventListener('input', () => {
		if (!(input instanceof HTMLInputElement) || !empty) return;
		if (input.value.trim()) empty.removeAttribute('hidden');
		else empty.setAttribute('hidden', '');
	});

	dialog?.addEventListener('click', (event) => {
		if (event.target === dialog) closeSearch();
	});

	document.addEventListener('keydown', (event) => {
		if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
			event.preventDefault();
			if (dialog instanceof HTMLDialogElement && dialog.open) closeSearch();
			else openSearch();
		}
		if (event.key === 'Escape') {
			closeThemeMenu();
			closeSearch();
		}
	});

	themeButton?.addEventListener('click', () => {
		if (!themeMenu || !themeButton) return;
		const willOpen = themeMenu.hidden;
		themeMenu.hidden = !willOpen;
		themeButton.setAttribute('aria-expanded', String(willOpen));
	});

	themeMenu?.addEventListener('click', (event) => {
		const item = event.target instanceof Element ? event.target.closest('[data-theme-value]') : null;
		if (!(item instanceof HTMLElement) || !item.dataset.themeValue) return;
		applyTheme(item.dataset.themeValue);
		closeThemeMenu();
		themeButton?.focus();
	});

	document.addEventListener('click', (event) => {
		if (!(event.target instanceof Node) || themeRoot?.contains(event.target)) return;
		closeThemeMenu();
	});

	matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
		if (root.dataset.theme === 'system') applyTheme('system');
	});

	syncThemeUi();
</script>

<style>
	.header {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		gap: 1rem;
		box-sizing: border-box;
		height: 48px;
		padding: 0 1.25rem;
		border-bottom: 1px solid var(--divider);
		background: var(--bg);
		position: sticky;
		top: 0;
		z-index: 20;
	}

	.start {
		display: flex;
		align-items: center;
		gap: 1rem;
		min-width: 0;
		justify-self: start;
	}

	.end {
		justify-self: end;
	}

	.logo {
		display: flex;
		flex: none;
	}

	.logo img {
		height: 26px;
		width: auto;
	}

	.logo img.logo-light {
		display: block;
	}

	.logo img.logo-dark {
		display: none;
	}

	:global(html[data-appearance='dark']) .logo img.logo-light {
		display: none;
	}

	:global(html[data-appearance='dark']) .logo img.logo-dark {
		display: block;
	}

	.tabs {
		display: flex;
		align-items: stretch;
		align-self: stretch;
		gap: 1.5rem;
		min-width: 0;
		height: 48px;
	}

	.tabs a,
	.tabs span {
		display: inline-flex;
		align-items: center;
		position: relative;
		height: 100%;
		color: var(--muted);
		text-decoration: none;
		padding: 0 0.15rem;
		white-space: nowrap;
	}

	.tabs a:hover {
		color: var(--fg);
	}

	.tabs a[aria-current='page'],
	.tabs a[aria-current='page']:hover {
		color: var(--primary);
		font-weight: 400;
		background: none;
	}

	.tabs a[aria-current='page']::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		bottom: -1px;
		height: 2px;
		background: var(--primary);
	}

	.search {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		box-sizing: border-box;
		width: 16rem;
		height: 36px;
		padding: 0 0.55rem 0 0.7rem;
		border: 1px solid var(--line);
		border-radius: 0.5rem;
		background: var(--bg);
		color: var(--muted);
		font: inherit;
		cursor: pointer;
	}

	@media (max-width: 1360px) {
		.search {
			width: 13rem;
		}
	}

	@media (max-width: 1320px) {
		.tabs {
			gap: 0.75rem;
		}

		.search {
			width: 11.5rem;
		}
	}

	.search span {
		flex: 1;
		text-align: left;
	}

	.search kbd {
		font-size: 11px;
		line-height: 1.3;
		padding: 0.05rem 0.3rem;
		border: 1px solid var(--line);
		border-radius: 0.25rem;
		color: var(--muted);
	}

	.theme {
		position: relative;
	}

	.theme-button {
		display: grid;
		place-items: center;
		width: 2rem;
		height: 2rem;
		border: 1px solid var(--line);
		border-radius: 0.5rem;
		background: var(--bg);
		color: var(--fg);
		cursor: pointer;
	}

	.theme-icon {
		display: none;
	}

	:global(html[data-theme='light']) .theme-icon[data-icon='light'],
	:global(html[data-theme='dark']) .theme-icon[data-icon='dark'],
	:global(html[data-theme='system']) .theme-icon[data-icon='system'],
	:global(html:not([data-theme])) .theme-icon[data-icon='system'] {
		display: block;
	}

	.theme-menu {
		position: absolute;
		top: calc(100% + 0.375rem);
		right: 0;
		z-index: 30;
		min-width: 9.5rem;
		margin: 0;
		padding: 0.25rem;
		border: 1px solid var(--line);
		border-radius: 0.5rem;
		background: var(--bg);
		box-shadow: var(--shadow);
	}

	.theme-menu[hidden] {
		display: none;
	}

	.theme-menu button {
		display: flex;
		align-items: center;
		width: 100%;
		gap: 0.5rem;
		padding: 0.4rem 0.55rem;
		border: 0;
		border-radius: 0.375rem;
		background: transparent;
		color: var(--fg);
		font: inherit;
		text-align: left;
		cursor: pointer;
	}

	.theme-menu button:hover {
		background: var(--fill);
	}

	.check {
		margin-left: auto;
		visibility: hidden;
	}

	.theme-menu button[aria-checked='true'] .check {
		visibility: visible;
	}

	.search-dialog {
		width: min(32rem, calc(100vw - 2rem));
		margin: 12vh auto auto;
		padding: 0;
		border: 1px solid var(--line);
		border-radius: 0.75rem;
		background: var(--bg);
		color: var(--fg);
		box-shadow: var(--shadow);
	}

	.search-dialog::backdrop {
		background: rgb(0 0 0 / 0.35);
	}

	.search-row {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		padding: 0.85rem 1rem;
		color: var(--muted);
	}

	.search-row input {
		flex: 1;
		border: 0;
		background: transparent;
		color: var(--fg);
		font: inherit;
		outline: none;
	}

	.search-empty {
		margin: 0;
		padding: 0.75rem 1rem 1rem;
		border-top: 1px solid var(--line);
		color: var(--muted);
	}

	.search:focus-visible,
	.theme-button:focus-visible,
	.tabs a:focus-visible,
	.theme-menu button:focus-visible {
		outline: 2px solid var(--fg);
		outline-offset: 2px;
	}
</style>
