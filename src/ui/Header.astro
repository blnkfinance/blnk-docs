---
import logoLight from '../content/images/dev-light-mode.svg?url';
import logoDark from '../content/images/dev-dark-mode.svg?url';
import { currentTab, navigation } from '../content/nav';

const root = navigation.navigation.root;
const tabs = navigation.navigation.tabs;
const current = currentTab(navigation, Astro.url.pathname)?.path;
---

<header class="header">
	<div class="start">
		<nav class="tabs" aria-label="Primary">
			<a class="logo" href={root.path} aria-current={root.path === current ? 'page' : undefined}>
				<img
					class="logo-light"
					src={logoLight}
					alt="blnk | Developer"
					width="192"
					height="28"
				/>
				<img class="logo-dark" src={logoDark} alt="" width="192" height="28" />
			</a>
			{
				tabs.map((tab) => (
					<a href={tab.path} aria-current={tab.path === current ? 'page' : undefined}>
						{tab.tab}
					</a>
				))
			}
		</nav>
	</div>

	<button
		class="search"
		type="button"
		aria-haspopup="dialog"
		aria-keyshortcuts="Meta+K Control+K"
		data-search-open
	>
		<svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true">
			<circle cx="7" cy="7" r="4.25" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
			<path d="M10.2 10.2 13.5 13.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
		</svg>
		<span>Search</span>
		<kbd data-search-kbd>⌘K</kbd>
	</button>

	<div class="end">
		<a
			class="dashboard"
			href="https://cloud.blnkfinance.com/auth/sign-in?utm_source=blnk_docs&utm_medium=documentation&utm_campaign=navbar"
			>Open Dashboard</a
		>
	</div>
</header>

<dialog class="search-dialog" aria-label="Search" data-search-dialog>
	<div class="search-row">
		<svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true">
			<circle cx="7" cy="7" r="4.25" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
			<path d="M10.2 10.2 13.5 13.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
		</svg>
		<input type="search" placeholder="Search docs" autocomplete="off" spellcheck="false" data-search-input />
	</div>
	<div class="search-results" hidden data-search-results>
		<p class="search-meta" data-search-meta></p>
		<div data-search-list></div>
	</div>
	<p class="search-empty" hidden data-search-empty>No matching pages.</p>
</dialog>

<script is:inline>
	const openButton = document.querySelector('[data-search-open]');
	const dialog = document.querySelector('[data-search-dialog]');
	const input = document.querySelector('[data-search-input]');
	const results = document.querySelector('[data-search-results]');
	const list = document.querySelector('[data-search-list]');
	const meta = document.querySelector('[data-search-meta]');
	const empty = document.querySelector('[data-search-empty]');
	const kbd = document.querySelector('[data-search-kbd]');

	const mac = /\bMac|iPhone|iPad/.test(navigator.userAgent);
	if (kbd) kbd.textContent = mac ? '⌘K' : 'Ctrl K';

	function closeThemeMenu() {
		const themeMenu = document.querySelector('[data-theme-menu]');
		const themeButton = document.querySelector('[data-theme-button]');
		if (!(themeMenu instanceof HTMLElement) || themeMenu.hidden) return;
		themeMenu.hidden = true;
		themeButton?.setAttribute('aria-expanded', 'false');
	}

	/** @type {any} */
	let pagefind = null;
	let pagefindFailed = false;
	let request = 0;

	function escapeHtml(value) {
		return value.replace(/[&<>"']/g, (char) => {
			if (char === '&') return '&amp;';
			if (char === '<') return '&lt;';
			if (char === '>') return '&gt;';
			if (char === '"') return '&quot;';
			return '&#39;';
		});
	}

	function highlight(value, terms) {
		const safe = escapeHtml(value);
		const pattern = terms.map((term) => term.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')).join('|');
		if (!pattern) return safe;
		return safe.replace(new RegExp(`(${pattern})`, 'gi'), '<mark>$1</mark>');
	}

	function resultHref(url) {
		if (!url) return '/';
		if (/^https?:/i.test(url)) return url;
		return url.startsWith('/') ? url : `/${url}`;
	}

	async function loadPagefind() {
		if (pagefind || pagefindFailed) return pagefind;
		try {
			pagefind = await import('/pagefind/pagefind.js');
			await pagefind.init();
			return pagefind;
		} catch {
			pagefindFailed = true;
			return null;
		}
	}

	function snippet(hit, terms) {
		const title = String(hit.meta?.title ?? '').trim();
		const plain = String(hit.plain_excerpt ?? '').trim();
		if (hit.excerpt && plain && plain.toLowerCase() !== title.toLowerCase()) return hit.excerpt;
		const description = hit.meta?.description;
		if (typeof description === 'string' && description.trim()) return highlight(description, terms);
		return '';
	}

	async function renderResults(immediate = false) {
		if (!(input instanceof HTMLInputElement) || !results || !list || !meta || !empty) return;
		const query = input.value.trim();
		const terms = query.split(/\s+/).filter(Boolean);
		if (!terms.length) {
			request += 1;
			results.hidden = true;
			empty.hidden = true;
			list.replaceChildren();
			return;
		}
		const id = ++request;
		const engine = await loadPagefind();
		if (id !== request) return;
		if (!engine) {
			results.hidden = true;
			list.replaceChildren();
			empty.textContent = 'Search is unavailable.';
			empty.hidden = false;
			return;
		}
		const search = immediate ? await engine.search(query) : await engine.debouncedSearch(query);
		if (!search || id !== request) return;
		const hits = await Promise.all(search.results.slice(0, 8).map((result) => result.data()));
		if (id !== request) return;
		if (!hits.length) {
			results.hidden = true;
			list.replaceChildren();
			empty.textContent = 'No matching pages.';
			empty.hidden = false;
			return;
		}
		empty.hidden = true;
		results.hidden = false;
		const total = search.results.length;
		meta.textContent = total === 1 ? '1 result' : `${total} results`;
		list.innerHTML = hits
			.map((hit) => {
				const section = hit.meta?.section
					? `<span class="search-hit-section">${highlight(String(hit.meta.section), terms)}</span>`
					: '';
				const text = snippet(hit, terms);
				return `<a class="search-hit" href="${escapeHtml(resultHref(hit.url))}">
					${section}
					<span class="search-hit-title">${highlight(String(hit.meta?.title ?? 'Untitled'), terms)}</span>
					${text ? `<p>${text}</p>` : ''}
				</a>`;
			})
			.join('');
	}

	function openSearch() {
		if (!(dialog instanceof HTMLDialogElement) || !(input instanceof HTMLInputElement)) return;
		closeThemeMenu();
		if (!dialog.open) dialog.showModal();
		input.focus();
		loadPagefind();
		if (input.value.trim()) renderResults(true);
	}

	function closeSearch() {
		if (dialog instanceof HTMLDialogElement && dialog.open) dialog.close();
	}

	openButton?.addEventListener('click', openSearch);

	input?.addEventListener('input', () => {
		renderResults(false);
	});

	dialog?.addEventListener('click', (event) => {
		if (event.target === dialog) closeSearch();
	});

	document.addEventListener('keydown', (event) => {
		if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
			event.preventDefault();
			if (dialog instanceof HTMLDialogElement && dialog.open) closeSearch();
			else openSearch();
		}
		if (event.key === 'Escape') {
			closeThemeMenu();
			closeSearch();
		}
	});

</script>

<style>
	.header {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		gap: 1rem;
		box-sizing: border-box;
		height: 48px;
		padding: 0 1.25rem;
		border-bottom: 1px solid var(--divider);
		background: var(--bg);
		position: sticky;
		top: 0;
		z-index: 20;
	}

	.start {
		display: flex;
		align-items: center;
		gap: 1rem;
		min-width: 0;
		justify-self: start;
	}

	.end {
		justify-self: end;
	}

	.dashboard {
		display: inline-flex;
		align-items: center;
		box-sizing: border-box;
		height: 32px;
		padding: 0 0.9rem;
		border-radius: 999px;
		background: oklch(0.15 0 0);
		color: oklch(1 0 0);
		text-decoration: none;
		white-space: nowrap;
	}

	.dashboard:hover {
		background: oklch(0.22 0 0);
		color: oklch(1 0 0);
	}

	:global(html[data-appearance='dark']) .dashboard {
		background: oklch(0.964 0 0);
		color: oklch(0.15 0 0);
	}

	:global(html[data-appearance='dark']) .dashboard:hover {
		background: oklch(0.9 0 0);
		color: oklch(0.15 0 0);
	}

	.logo {
		display: flex;
		flex: none;
	}

	.logo img {
		height: 22px;
		width: auto;
		transform: translateY(-0.5px);
	}

	.logo img.logo-light {
		display: block;
	}

	.logo img.logo-dark {
		display: none;
	}

	:global(html[data-appearance='dark']) .logo img.logo-light {
		display: none;
	}

	:global(html[data-appearance='dark']) .logo img.logo-dark {
		display: block;
	}

	.tabs {
		display: flex;
		align-items: stretch;
		align-self: stretch;
		gap: 1.5rem;
		min-width: 0;
		height: 48px;
	}

	.tabs a,
	.tabs span {
		display: inline-flex;
		align-items: center;
		position: relative;
		height: 100%;
		color: var(--muted);
		text-decoration: none;
		padding: 0 0.15rem;
		white-space: nowrap;
	}

	.tabs a:not(.logo):hover {
		color: var(--primary);
	}

	.tabs a[aria-current='page'],
	.tabs a[aria-current='page']:hover {
		color: var(--primary);
		font-weight: 400;
		background: none;
	}

	.tabs a[aria-current='page']:not(.logo)::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		bottom: -1px;
		height: 2px;
		background: var(--primary);
	}

	.search {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		box-sizing: border-box;
		width: 16rem;
		height: 36px;
		padding: 0 0.55rem 0 0.7rem;
		border: 1px solid var(--line);
		border-radius: 0.5rem;
		background: var(--bg);
		color: var(--muted);
		font: inherit;
		cursor: pointer;
	}

	@media (max-width: 1360px) {
		.search {
			width: 13rem;
		}
	}

	@media (max-width: 1320px) {
		.tabs {
			gap: 0.75rem;
		}

		.search {
			width: 11.5rem;
		}
	}

	.search span {
		flex: 1;
		text-align: left;
	}

	.search kbd {
		font-size: 11px;
		line-height: 1.3;
		padding: 0.05rem 0.3rem;
		border: 1px solid var(--line);
		border-radius: 0.25rem;
		color: var(--muted);
	}

	.search-dialog {
		width: min(42rem, calc(100vw - 2rem));
		margin: 12vh auto auto;
		padding: 0;
		border: 1px solid var(--line);
		border-radius: 0.75rem;
		background: var(--bg);
		color: var(--fg);
		box-shadow: var(--shadow);
	}

	.search-dialog::backdrop {
		background: rgb(0 0 0 / 0.35);
	}

	.search-row {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		position: sticky;
		top: 0;
		padding: 0.85rem 1rem;
		border-bottom: 1px solid var(--line);
		background: var(--bg);
		color: var(--muted);
	}

	.search-row input {
		flex: 1;
		border: 0;
		background: transparent;
		color: var(--fg);
		font: inherit;
		outline: none;
	}

	.search-results {
		padding: 0.35rem;
	}

	.search-meta {
		margin: 0;
		padding: 0.35rem 0.7rem 0.15rem;
		color: var(--muted);
		font-size: 12px;
	}

	:global(.search-hit) {
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
		padding: 0.6rem 0.7rem;
		border-radius: 0.5rem;
		color: var(--fg);
		text-decoration: none;
	}

	:global(.search-hit:hover) {
		background: var(--fill);
	}

	:global(.search-hit-section) {
		color: var(--muted);
		font-size: 12px;
	}

	:global(.search-hit-title) {
		font-weight: 500;
	}

	:global(.search-hit p) {
		margin: 0.15rem 0 0;
		color: var(--muted);
	}

	:global(.search-hit mark) {
		background: color-mix(in oklch, var(--primary) 32%, transparent);
		color: var(--fg);
		border-radius: 0.15em;
	}

	.search-empty {
		margin: 0;
		padding: 0.75rem 1rem 1rem;
		color: var(--muted);
	}

	.search:focus-visible,
	.dashboard:focus-visible,
	.tabs a:focus-visible {
		outline: 2px solid var(--fg);
		outline-offset: 2px;
	}
</style>
