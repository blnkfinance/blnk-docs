---
import { getCollection } from 'astro:content';
import logoLight from '../content/img/logo/dev-light-mode.svg?url';
import logoDark from '../content/img/logo/dev-dark-mode.svg?url';
import { renderIcon } from '../icons/mingcute';
import { activeMenu, currentTab, linkHref, navigation, pageHref, type NavTab } from './navigation';

const chevron = await renderIcon('down', 14);
const searchIcon = await renderIcon('search-2', 16);
const menuIcon = await renderIcon('menu', 20);
const closeIcon = await renderIcon('close', 20);

const tabs = navigation.navigation.tabs;
const pathname = Astro.url.pathname;
const hrefs = new Set((await getCollection('docs')).map((entry) => pageHref(entry.id)));
const open = currentTab(navigation, pathname);

function tabCurrent(tab: NavTab): boolean {
	return open != null && 'tab' in open && open.tab === tab.tab;
}
---

<header class="header" transition:persist="site-header" transition:animate="none">
	<button class="nav-open" type="button" aria-label="Menu" aria-controls="docs-nav" aria-expanded="false" data-nav-open>
		<span class="nav-glyph" data-glyph="menu"><Fragment set:html={menuIcon} /></span>
		<span class="nav-glyph" data-glyph="close"><Fragment set:html={closeIcon} /></span>
	</button>
	<div class="start">
		<a class="logo" href="/">
			<img
				class="logo-light"
				src={logoLight}
				alt="blnk | Developer"
				width="192"
				height="28"
			/>
			<img class="logo-dark" src={logoDark} alt="" width="192" height="28" />
		</a>
		<nav class="tabs" aria-label="Primary">
			{
				tabs.map((tab) =>
					'menu' in tab ? (
						<div class="tab-menu" data-tab-menu>
							<button
								class="tab-button"
								type="button"
								aria-haspopup="menu"
								aria-expanded="false"
								aria-current={tabCurrent(tab) ? 'page' : undefined}
								data-tab-button
							>
								{tab.tab}
								<span class="tab-chevron"><Fragment set:html={chevron} /></span>
							</button>
							<div class="tab-popover" role="menu" hidden data-tab-popover>
								{
									tab.menu.map((item) => (
										<a
											role="menuitem"
											href={linkHref(item.path, item.groups, hrefs)}
											aria-current={activeMenu(tab, pathname)?.path === item.path ? 'page' : undefined}
										>
											{item.label}
										</a>
									))
								}
							</div>
						</div>
					) : (
						<a href={linkHref(tab.path, tab.groups, hrefs)} aria-current={tabCurrent(tab) ? 'page' : undefined}>
							{tab.tab}
						</a>
					),
				)
			}
		</nav>
	</div>

	<button
		class="search"
		type="button"
		aria-haspopup="dialog"
		aria-keyshortcuts="Meta+K Control+K"
		data-search-open
	>
		<Fragment set:html={searchIcon} />
		<span>Search</span>
		<kbd data-search-kbd>⌘K</kbd>
	</button>

	<div class="end">
		<a
			class="dashboard"
			href="https://cloud.blnkfinance.com/auth/sign-in?utm_source=blnk_docs&utm_medium=documentation&utm_campaign=navbar"
			>Open Dashboard</a
		>
	</div>
</header>

<button
	class="nav-backdrop"
	type="button"
	aria-label="Close menu"
	hidden
	data-nav-backdrop
	transition:persist="nav-backdrop"
	transition:animate="none"
></button>

<dialog
	class="search-dialog"
	aria-label="Search"
	data-search-dialog
	transition:persist="search-dialog"
	transition:animate="none"
>
	<div class="search-row">
		<Fragment set:html={searchIcon} />
		<input
			type="search"
			placeholder="Search docs"
			autocomplete="off"
			spellcheck="false"
			aria-autocomplete="list"
			aria-controls="search-list"
			data-search-input
		/>
	</div>
	<div class="search-results" hidden data-search-results>
		<p class="search-meta" data-search-meta></p>
		<div id="search-list" role="listbox" data-search-list></div>
	</div>
	<p class="search-empty" hidden data-search-empty>No matching pages.</p>
</dialog>

<script is:inline>
	(() => {
	if (globalThis.__docsSearchBound) return;
	globalThis.__docsSearchBound = true;
	const openButton = document.querySelector('[data-search-open]');
	const dialog = document.querySelector('[data-search-dialog]');
	const input = document.querySelector('[data-search-input]');
	const results = document.querySelector('[data-search-results]');
	const list = document.querySelector('[data-search-list]');
	const meta = document.querySelector('[data-search-meta]');
	const empty = document.querySelector('[data-search-empty]');
	const kbd = document.querySelector('[data-search-kbd]');

	const mac = /\bMac|iPhone|iPad/.test(navigator.userAgent);
	if (kbd) kbd.textContent = mac ? '⌘K' : 'Ctrl K';

	function closeThemeMenu() {
		const themeMenu = document.querySelector('[data-theme-menu]');
		const themeButton = document.querySelector('[data-theme-button]');
		if (!(themeMenu instanceof HTMLElement) || themeMenu.hidden) return;
		themeMenu.hidden = true;
		themeButton?.setAttribute('aria-expanded', 'false');
	}

	/** @type {any} */
	let pagefind = null;
	let pagefindFailed = false;
	let request = 0;
	let active = -1;
	const recentKey = 'docs-search-recent';
	const maxResults = 12;

	function escapeHtml(value) {
		return value.replace(/[&<>"']/g, (char) => {
			if (char === '&') return '&amp;';
			if (char === '<') return '&lt;';
			if (char === '>') return '&gt;';
			if (char === '"') return '&quot;';
			return '&#39;';
		});
	}

	function highlight(value, terms) {
		const safe = escapeHtml(value);
		const pattern = terms
			.map((term) => `${term.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')}[\\p{L}\\p{N}]*`)
			.join('|');
		if (!pattern) return safe;
		return safe.replace(new RegExp(`(${pattern})`, 'giu'), '<mark>$1</mark>');
	}

	function resultHref(url) {
		if (!url) return '/';
		if (/^https?:/i.test(url)) return url;
		const hashAt = url.indexOf('#');
		const path = hashAt === -1 ? url : url.slice(0, hashAt);
		const hash = hashAt === -1 ? '' : url.slice(hashAt);
		const normalized = path.startsWith('/') ? path : `/${path}`;
		return `${normalized}${hash}`;
	}

	function sameText(left, right) {
		return left.trim().toLowerCase() === right.trim().toLowerCase();
	}

	function readRecent() {
		try {
			const parsed = JSON.parse(localStorage.getItem(recentKey) || '[]');
			if (!Array.isArray(parsed)) return [];
			return parsed
				.filter((item) => item && typeof item.url === 'string' && typeof item.title === 'string')
				.slice(0, 5);
		} catch {
			return [];
		}
	}

	function remember(item) {
		const next = [item, ...readRecent().filter((saved) => saved.url !== item.url)].slice(0, 5);
		localStorage.setItem(recentKey, JSON.stringify(next));
	}

	async function loadPagefind() {
		if (pagefind || pagefindFailed) return pagefind;
		try {
			pagefind = await import('/pagefind/pagefind.js');
			await pagefind.init();
			return pagefind;
		} catch {
			pagefindFailed = true;
			return null;
		}
	}

	function excerptHtml(item) {
		const title = String(item.title ?? '').trim();
		const plain = String(item.plain_excerpt ?? '').trim();
		if (item.excerpt && plain && !sameText(plain, title)) return item.excerpt;
		if (typeof item.description === 'string' && item.description.trim()) return highlight(item.description, item.terms ?? []);
		return '';
	}

	function hitLink(item, terms) {
		const href = resultHref(item.url);
		const label = item.kicker
			? `<span class="search-hit-section">${escapeHtml(item.kicker)}</span>`
			: '';
		const text = excerptHtml({ ...item, terms });
		return `<a class="search-hit" role="option" href="${escapeHtml(href)}" data-search-hit data-title="${escapeHtml(item.title)}" data-page-title="${escapeHtml(item.pageTitle)}" data-category="${escapeHtml(item.category || '')}">
			${label}
			<span class="search-hit-title">${highlight(item.title, terms)}</span>
			${text ? `<p>${text}</p>` : ''}
		</a>`;
	}

	function groupsFrom(hit) {
		const pageTitle = String(hit.meta?.title ?? 'Untitled');
		const category = String(hit.meta?.section ?? '');
		const description = typeof hit.meta?.description === 'string' ? hit.meta.description : '';
		const subs = Array.isArray(hit.sub_results) && hit.sub_results.length
			? hit.sub_results
			: [{ title: pageTitle, url: hit.url, excerpt: hit.excerpt, plain_excerpt: hit.plain_excerpt }];
		const sections = subs.filter((sub) => {
			const url = String(sub.url ?? '');
			return url.includes('#') && !sameText(String(sub.title ?? ''), pageTitle);
		});
		const source = sections.length
			? sections
			: [{ title: pageTitle, url: hit.url, excerpt: hit.excerpt, plain_excerpt: hit.plain_excerpt }];
		const items = source.map((sub) => ({
			title: String(sub.title ?? pageTitle),
			url: String(sub.url ?? hit.url),
			excerpt: sub.excerpt,
			plain_excerpt: sub.plain_excerpt,
			description: sections.length ? '' : description,
			pageTitle,
			category,
		}));
		return { pageTitle, category, items };
	}

	function renderHits(groups, terms) {
		if (!list) return;
		list.innerHTML = groups
			.map((group) => {
				const grouped = group.items.some((item) => !sameText(item.title, group.pageTitle));
				const links = group.items
					.map((item) =>
						hitLink(
							{
								...item,
								kicker: grouped ? '' : item.category,
							},
							terms,
						),
					)
					.join('');
				if (!grouped) return `<div class="search-group" role="presentation">${links}</div>`;
				const category = group.category
					? `<span class="search-hit-section">${escapeHtml(group.category)}</span>`
					: '';
				return `<div class="search-group" role="group" aria-label="${escapeHtml(group.pageTitle)}">
					<div class="search-group-label" aria-hidden="true"><svg class="search-group-icon" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-width="2" d="M13 3v5.5a.5.5 0 0 0 .5.5H19m-5.414-6H6a1 1 0 0 0-1 1v16a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V8.414a1 1 0 0 0-.293-.707l-4.414-4.414A1 1 0 0 0 13.586 3Z"/></svg><span>${highlight(group.pageTitle, terms)}</span>${category}</div>
					<div class="search-group-items">${links}</div>
				</div>`;
			})
			.join('');
		setActive(0);
	}

	function currentHits() {
		if (!list) return [];
		return [...list.querySelectorAll('[data-search-hit]')];
	}

	function setActive(index, scroll = true) {
		const items = currentHits();
		if (!(input instanceof HTMLInputElement)) return;
		if (!items.length) {
			active = -1;
			input.removeAttribute('aria-activedescendant');
			return;
		}
		active = (index + items.length) % items.length;
		items.forEach((item, itemIndex) => {
			const selected = itemIndex === active;
			item.toggleAttribute('data-active', selected);
			item.setAttribute('aria-selected', String(selected));
			if (selected) {
				item.id = 'search-hit-active';
				input.setAttribute('aria-activedescendant', item.id);
				if (scroll) item.scrollIntoView({ block: 'nearest' });
			} else {
				item.removeAttribute('id');
			}
		});
	}

	function showRecent() {
		if (!results || !list || !meta || !empty) return;
		const recent = readRecent();
		if (!recent.length) {
			results.hidden = true;
			empty.hidden = true;
			list.replaceChildren();
			active = -1;
			return;
		}
		empty.hidden = true;
		results.hidden = false;
		meta.textContent = 'Recent';
		renderHits(
			recent.map((item) => ({
				pageTitle: item.pageTitle || item.title,
				category: item.category || '',
				items: [
					{
						title: item.title,
						url: item.url,
						pageTitle: item.pageTitle || item.title,
						category: item.category || '',
						kicker: item.title === item.pageTitle ? item.category || '' : item.pageTitle || item.category || '',
					},
				],
			})),
			[],
		);
	}

	async function renderResults(immediate = false) {
		if (!(input instanceof HTMLInputElement) || !results || !list || !meta || !empty) return;
		const query = input.value.trim();
		const terms = query.split(/\s+/).filter(Boolean);
		if (!terms.length) {
			request += 1;
			showRecent();
			return;
		}
		const id = ++request;
		const engine = await loadPagefind();
		if (id !== request) return;
		if (!engine) {
			results.hidden = true;
			list.replaceChildren();
			empty.textContent = 'Search is unavailable.';
			empty.hidden = false;
			return;
		}
		const search = immediate ? await engine.search(query) : await engine.debouncedSearch(query);
		if (!search || id !== request) return;
		const pages = await Promise.all(search.results.map((result) => result.data()));
		if (id !== request) return;
		const groups = [];
		let shown = 0;
		for (const page of pages) {
			if (shown >= maxResults) break;
			const group = groupsFrom(page);
			group.items = group.items.slice(0, maxResults - shown);
			shown += group.items.length;
			if (group.items.length) groups.push(group);
		}
		if (!shown) {
			results.hidden = true;
			list.replaceChildren();
			empty.textContent = 'No matching pages.';
			empty.hidden = false;
			active = -1;
			return;
		}
		empty.hidden = true;
		results.hidden = false;
		meta.textContent = shown === 1 ? '1 result' : `${shown} results`;
		renderHits(groups, terms);
	}

	function openSearch() {
		if (!(dialog instanceof HTMLDialogElement) || !(input instanceof HTMLInputElement)) return;
		closeThemeMenu();
		if (!dialog.open) dialog.showModal();
		input.focus();
		loadPagefind();
		if (input.value.trim()) renderResults(true);
		else showRecent();
	}

	function typingTarget(target) {
		if (!(target instanceof HTMLElement)) return false;
		const tag = target.tagName;
		return tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT' || target.isContentEditable;
	}

	function closeSearch() {
		if (dialog instanceof HTMLDialogElement && dialog.open) dialog.close();
	}

	openButton?.addEventListener('click', openSearch);

	input?.addEventListener('input', () => {
		renderResults(false);
	});

	list?.addEventListener('click', (event) => {
		const hit = event.target instanceof Element ? event.target.closest('[data-search-hit]') : null;
		if (!(hit instanceof HTMLAnchorElement)) return;
		remember({
			title: hit.dataset.title || hit.textContent || '',
			url: hit.getAttribute('href') || '/',
			pageTitle: hit.dataset.pageTitle || hit.dataset.title || '',
			category: hit.dataset.category || '',
		});
	});

	list?.addEventListener('mouseover', (event) => {
		const hit = event.target instanceof Element ? event.target.closest('[data-search-hit]') : null;
		if (!(hit instanceof HTMLElement)) return;
		const index = currentHits().indexOf(hit);
		if (index !== -1 && index !== active) setActive(index, false);
	});

	dialog?.addEventListener('click', (event) => {
		if (event.target === dialog) closeSearch();
	});

	document.addEventListener('keydown', (event) => {
		const searchOpen = dialog instanceof HTMLDialogElement && dialog.open;
		if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
			event.preventDefault();
			if (searchOpen) closeSearch();
			else openSearch();
			return;
		}
		if (event.key === '/' && !searchOpen && !event.metaKey && !event.ctrlKey && !event.altKey && !typingTarget(event.target)) {
			event.preventDefault();
			openSearch();
			return;
		}
		if (!searchOpen) {
			if (event.key === 'Escape') closeThemeMenu();
			return;
		}
		if (event.key === 'Escape') {
			closeThemeMenu();
			closeSearch();
			return;
		}
		const items = currentHits();
		if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
			event.preventDefault();
			if (items.length) setActive(active + (event.key === 'ArrowDown' ? 1 : -1));
			return;
		}
		if ((event.key === 'Home' || event.key === 'End') && items.length) {
			event.preventDefault();
			setActive(event.key === 'Home' ? 0 : items.length - 1);
			return;
		}
		if (event.key === 'Enter' && items[active] instanceof HTMLAnchorElement) {
			event.preventDefault();
			items[active].click();
		}
	});
	})();
</script>

<script>
	const tabNav = document.querySelector('.tabs');
	const tabHover = matchMedia('(hover: hover) and (pointer: fine)').matches;

	function closeTabMenus(except: Element | null) {
		tabNav?.querySelectorAll('[data-tab-menu]').forEach((menu) => {
			if (menu === except) return;
			const popover = menu.querySelector('[data-tab-popover]');
			const button = menu.querySelector('[data-tab-button]');
			if (popover instanceof HTMLElement) popover.hidden = true;
			button?.setAttribute('aria-expanded', 'false');
		});
	}

	function openTabMenu(menu: Element) {
		const popover = menu.querySelector('[data-tab-popover]');
		const button = menu.querySelector('[data-tab-button]');
		if (!(popover instanceof HTMLElement)) return;
		closeTabMenus(menu);
		popover.hidden = false;
		button?.setAttribute('aria-expanded', 'true');
	}

	tabNav?.querySelectorAll('[data-tab-menu]').forEach((menu) => {
		if (!tabHover) return;
		menu.addEventListener('mouseenter', () => openTabMenu(menu));
		menu.addEventListener('mouseleave', () => {
			if (menu.contains(document.activeElement)) return;
			closeTabMenus(null);
		});
		menu.addEventListener('focusin', () => openTabMenu(menu));
		menu.addEventListener('focusout', (event) => {
			if (!(event instanceof FocusEvent)) return;
			const next = event.relatedTarget;
			if (next instanceof Node && menu.contains(next)) return;
			closeTabMenus(null);
		});
	});

	tabNav?.addEventListener('click', (event) => {
		if (!(event instanceof MouseEvent)) return;
		const button = event.target instanceof Element ? event.target.closest('[data-tab-button]') : null;
		if (!(button instanceof HTMLButtonElement)) return;
		// A pointer click while the menu is already open from hover should not dismiss it.
		if (tabHover && event.detail !== 0) return;
		const menu = button.closest('[data-tab-menu]');
		const popover = menu?.querySelector('[data-tab-popover]');
		if (!(menu instanceof HTMLElement) || !(popover instanceof HTMLElement)) return;
		const willOpen = popover.hidden;
		if (willOpen) openTabMenu(menu);
		else closeTabMenus(null);
	});

	document.addEventListener('click', (event) => {
		if (!(event.target instanceof Node) || tabNav?.contains(event.target)) return;
		closeTabMenus(null);
	});

	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape') closeTabMenus(null);
	});

	function syncTabs(next: Document) {
		const currentNav = document.querySelector('.tabs');
		const nextNav = next.querySelector('.tabs');
		if (!(currentNav instanceof HTMLElement) || !(nextNav instanceof HTMLElement)) return;
		const currentItems = [...currentNav.querySelectorAll('a, [data-tab-button]')];
		const nextItems = [...nextNav.querySelectorAll('a, [data-tab-button]')];
		currentItems.forEach((item, index) => {
			const incoming = nextItems[index];
			if (!(item instanceof HTMLElement) || !(incoming instanceof HTMLElement)) return;
			const value = incoming.getAttribute('aria-current');
			if (value) item.setAttribute('aria-current', value);
			else item.removeAttribute('aria-current');
		});
	}

	document.addEventListener('astro:before-swap', (event) => {
		const next = (event as Event & { newDocument?: Document }).newDocument;
		if (!next) return;
		syncTabs(next);
		closeTabMenus(null);
		const dialog = document.querySelector('[data-search-dialog]');
		if (dialog instanceof HTMLDialogElement && dialog.open) dialog.close();
	});
</script>

<style>
	.header {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		gap: 1rem;
		box-sizing: border-box;
		height: 48px;
		padding: 0 1.25rem;
		font-size: 14px;
		border-bottom: 1px solid var(--divider);
		background: var(--bg);
		position: sticky;
		top: 0;
		z-index: 20;
	}

	.nav-open,
	.nav-backdrop {
		display: none;
	}

	.nav-glyph {
		display: inline-flex;
	}

	.nav-glyph[data-glyph='close'] {
		display: none;
	}

	:global(html[data-nav='open']) .nav-glyph[data-glyph='menu'] {
		display: none;
	}

	:global(html[data-nav='open']) .nav-glyph[data-glyph='close'] {
		display: inline-flex;
	}

	.nav-glyph :global(svg) {
		display: block;
		overflow: visible;
	}

	.start {
		display: flex;
		align-items: center;
		gap: 1.5rem;
		min-width: 0;
		justify-self: start;
	}

	.end {
		justify-self: end;
	}

	.dashboard {
		display: inline-flex;
		align-items: center;
		box-sizing: border-box;
		height: 32px;
		padding: 0 0.9rem;
		border-radius: 999px;
		background: oklch(0.32 0 0);
		color: oklch(0.97 0 0);
		font-size: 14px;
		text-decoration: none;
		white-space: nowrap;
	}

	.dashboard:hover {
		background: oklch(0.38 0 0);
		color: oklch(0.97 0 0);
	}

	:global(html[data-appearance='dark']) .dashboard {
		background: oklch(0.9 0 0);
		color: oklch(0.15 0 0);
	}

	:global(html[data-appearance='dark']) .dashboard:hover {
		background: oklch(0.84 0 0);
		color: oklch(0.15 0 0);
	}

	.logo {
		display: flex;
		flex: none;
	}

	.logo img {
		height: 22px;
		width: auto;
		transform: translateY(-0.5px);
	}

	.logo img.logo-light {
		display: block;
	}

	.logo img.logo-dark {
		display: none;
	}

	:global(html[data-appearance='dark']) .logo img.logo-light {
		display: none;
	}

	:global(html[data-appearance='dark']) .logo img.logo-dark {
		display: block;
	}

	.tabs {
		display: flex;
		align-items: stretch;
		align-self: stretch;
		gap: 1.5rem;
		min-width: 0;
		height: 48px;
	}

	.tabs > a,
	.tab-button {
		display: inline-flex;
