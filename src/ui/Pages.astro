---
import { matchesPage, pageHref, type NavItem } from './navigation';
import Pages from './Pages.astro';

interface Props {
	pages: NavItem[];
	titles: Map<string, string>;
	pathname: string;
	idPrefix: string;
	id?: string;
	open?: boolean;
}

const { pages, titles, pathname, idPrefix, id, open } = Astro.props;

function contains(item: NavItem): boolean {
	if (typeof item === 'string') return matchesPage(item, pathname);
	if (item.page && matchesPage(item.page, pathname)) return true;
	return item.pages.some((child) => contains(child));
}

function childSelected(item: Extract<NavItem, { dropdown: string }>): boolean {
	return item.pages.some((child) => contains(child));
}
---

<ul class="nav-pages" id={id} hidden={open === false ? true : undefined}>
	{
		pages.map((page, index) => {
			if (typeof page === 'string') {
				const current = matchesPage(page, pathname);
				return (
					<li>
						<a class="nav-item" href={pageHref(page)} aria-current={current ? 'page' : undefined}>
							<span class="nav-text">{titles.get(page) ?? page}</span>
						</a>
					</li>
				);
			}

			const panelId = `${idPrefix}-${index}`;
			const expanded = contains(page);
			const label = page.dropdown;
			const current = childSelected(page);

			return (
				<li>
					<button
						class:list={['nav-item', { 'is-current': current }]}
						type="button"
						data-nav-toggle
						aria-expanded={String(expanded)}
						aria-controls={panelId}
					>
						<span class="nav-text">{label}</span>
						<span class="nav-mark" aria-hidden="true"><span></span><span></span></span>
					</button>
					<Pages
						pages={page.pages}
						titles={titles}
						pathname={pathname}
						idPrefix={panelId}
						id={panelId}
						open={expanded}
					/>
				</li>
			);
		})
	}
</ul>
