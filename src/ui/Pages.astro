---
import { renderIcon } from '../icons/mingcute';
import { isDropdown, itemPath, matchesPage, methodLabel, pageHref, type NavItem } from './navigation';
import Pages from './Pages.astro';

interface Props {
	pages: NavItem[];
	titles: Map<string, string>;
	/** Frontmatter `icon` on each page. Direct children of a group use it. Nested pages do not. */
	pageIcons: Map<string, string>;
	methods: Map<string, string>;
	pathname: string;
	idPrefix: string;
	id?: string;
	open?: boolean;
	/** Anything inside a dropdown stays unlabeled by an icon. */
	nested?: boolean;
}

const { pages, titles, pageIcons, methods, pathname, idPrefix, id, open, nested = false } = Astro.props;

function contains(item: NavItem): boolean {
	const path = itemPath(item);
	if (path && matchesPage(path, pathname)) return true;
	return isDropdown(item) && item.pages.some((child) => contains(child));
}

function childSelected(item: Extract<NavItem, { dropdown: string }>): boolean {
	return item.pages.some((child) => contains(child));
}

/** Page rows use frontmatter. A dropdown uses its own nav icon. Nested rows stay plain. */
function iconName(item: NavItem): string | undefined {
	if (nested) return undefined;
	if (isDropdown(item)) return item.icon;
	const path = itemPath(item);
	return path ? pageIcons.get(path) : undefined;
}

const icons = new Map<string, string>();
for (const page of pages) {
	const name = iconName(page);
	if (!name || icons.has(name)) continue;
	const svg = await renderIcon(name, 16);
	if (svg) icons.set(name, svg);
}
const mark = await renderIcon('add', 16);
---

<ul class="nav-pages" id={id} hidden={open === false ? true : undefined}>
	{
		pages.map((page, index) => {
			if (!isDropdown(page)) {
				const path = itemPath(page);
				if (!path) return null;
				const current = matchesPage(path, pathname);
				const method = methods.get(path);
				const icon = icons.get(iconName(page) ?? '');
				return (
					<li>
						<a class="nav-item" href={pageHref(path)} aria-current={current ? 'page' : undefined}>
							{icon && !method && (
								<span class="nav-icon">
									<Fragment set:html={icon} />
								</span>
							)}
							{method && (
								<span class="method" data-method={method}>
									{methodLabel(method)}
								</span>
							)}
							<span class="nav-text">{titles.get(path) ?? path}</span>
						</a>
					</li>
				);
			}

			const panelId = `${idPrefix}-${index}`;
			const expanded = contains(page);
			const label = page.dropdown;
			const current = childSelected(page);
			const icon = icons.get(iconName(page) ?? '');

			return (
				<li>
					<button
						class:list={['nav-item', { 'is-current': current }]}
						type="button"
						data-nav-toggle
						aria-expanded={String(expanded)}
						aria-controls={panelId}
					>
						{icon && (
							<span class="nav-icon">
								<Fragment set:html={icon} />
							</span>
						)}
						<span class="nav-text">{label}</span>
						<span class="nav-mark" aria-hidden="true">
							<Fragment set:html={mark} />
						</span>
					</button>
					<Pages
						pages={page.pages}
						titles={titles}
						pageIcons={pageIcons}
						methods={methods}
						pathname={pathname}
						idPrefix={panelId}
						id={panelId}
						open={expanded}
						nested
					/>
				</li>
			);
		})
	}
</ul>
